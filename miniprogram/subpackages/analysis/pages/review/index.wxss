.page{min-height:100vh;background:#F5F5F5;padding-bottom:40rpx}
.disclaimer{font-size:20rpx;color:#BBB;text-align:center;padding:16rpx 24rpx 0}
.loading-text{text-align:center;padding-top:120rpx;font-size:28rpx;color:#999}
.empty-box{margin:60rpx 40rpx 0;background:#FFF;border-radius:16rpx;padding:56rpx 40rpx;text-align:center}
.empty-main{font-size:30rpx;color:#333;font-weight:600;margin-bottom:12rpx}
.empty-sub{font-size:24rpx;color:#999;margin-bottom:8rpx;line-height:1.6}
.retry-btn{display:inline-block;font-size:26rpx;color:var(--primary);border:1rpx solid var(--primary);border-radius:32rpx;padding:10rpx 44rpx;margin-top:28rpx}

/* tab 栏 */
.tab-bar{display:flex;background:#FFF;border-bottom:1rpx solid #F0F0F0}
.tab-item{flex:1;text-align:center;font-size:28rpx;color:#999;padding:22rpx 0;position:relative}
.tab-item.active{color:var(--primary);font-weight:600}
.tab-item.active::after{content:'';position:absolute;left:50%;transform:translateX(-50%);bottom:0;width:64rpx;height:6rpx;border-radius:3rpx;background:var(--primary)}

/* 亏损持仓列表（首页缓存直出） */
.fl-row{display:flex;align-items:center;padding:18rpx 0;border-bottom:1rpx solid #F5F5F5}
.fl-row:last-child{border-bottom:none}
.fl-row.fl-active{background:#FAF7F2;margin:0 -12rpx;padding:18rpx 12rpx;border-radius:12rpx}
.fl-info{flex:1;min-width:0;margin-right:16rpx}
.fl-name{font-size:26rpx;color:#333;margin-bottom:8rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fl-bar{height:10rpx;background:#F0F0F0;border-radius:5rpx;overflow:hidden}
.fl-fill{height:100%;background:linear-gradient(90deg,#FFB74D,#FA8C16);border-radius:5rpx}
.fl-right{flex-shrink:0;text-align:right}
.fl-detail{font-size:20rpx;color:#999;margin-top:8rpx}
.fl-pct{font-size:30rpx;font-weight:700;color:var(--primary)}
.fl-gap{font-size:20rpx;color:#999;margin-top:2rpx}

.card{margin:16rpx 24rpx 0;background:#FFF;border-radius:16rpx;padding:24rpx 28rpx}
.card-title{font-size:28rpx;font-weight:600;color:#333;margin-bottom:16rpx}
.card-sub{font-size:20rpx;color:#BBB;font-weight:400;margin-left:12rpx}

/* 回本进度（与详情页 rebate 同款视觉） */

/* 历史修复分布 */
.ep-sum{font-size:24rpx;color:#666;line-height:1.7;margin-bottom:16rpx}
.ep-strong{color:var(--primary);font-weight:700}
.ep-row{display:flex;align-items:center;padding:10rpx 0}
.ep-depth{width:100rpx;font-size:22rpx;color:#333;flex-shrink:0}
.ep-bar-wrap{flex:1;height:14rpx;background:#F5F5F5;border-radius:7rpx;overflow:hidden}
.ep-bar{height:100%;background:var(--primary);opacity:.65;border-radius:7rpx}
.ep-bar.fail{background:#E4A23C;opacity:.9}
.ep-days{width:150rpx;text-align:right;font-size:22rpx;color:#999;flex-shrink:0}
.ep-days.fail-text{color:#B26A00}
.ep-more{margin-top:8rpx;font-size:20rpx;color:#BBB}
.ep-none{font-size:24rpx;color:#666;line-height:1.7;margin-bottom:12rpx}
.ep-note{margin-top:14rpx;font-size:20rpx;color:#BBB;line-height:1.5}

/* 摊薄演算 */
.chips{display:flex;gap:16rpx;margin-bottom:16rpx}
.chip{font-size:22rpx;color:#888;background:#F2F2F2;border-radius:20rpx;padding:8rpx 24rpx}
.input-row{display:flex;align-items:center;background:#F8F8F8;border-radius:12rpx;padding:16rpx 20rpx}
.amount-input{flex:1;font-size:28rpx;color:#333}
.input-unit{font-size:24rpx;color:#999;margin-left:12rpx}
.dilute-result{margin-top:16rpx;font-size:24rpx;color:#333;line-height:1.7;background:#FAFAF5;border-radius:12rpx;padding:16rpx}
.dilute-note{margin-top:12rpx;font-size:20rpx;color:#BBB;line-height:1.5}
.no-holding{font-size:24rpx;color:#999}

/* 温度回测 */
.meta-card{margin:16rpx 24rpx 0;background:#FFF;border-radius:16rpx;padding:8rpx 28rpx}
.meta-row{display:flex;justify-content:space-between;padding:18rpx 0;border-bottom:1rpx solid #F5F5F5;font-size:26rpx}
.meta-row:last-child{border-bottom:none}
.meta-k{color:#999}
.meta-v{color:#333}

.h-card{margin:16rpx 24rpx 0;background:#FFF;border-radius:16rpx;padding:8rpx 28rpx 20rpx}
.h-title{font-size:28rpx;font-weight:600;color:#333;padding:22rpx 0 6rpx;border-bottom:1rpx solid #F5F5F5}
.g-row{display:flex;align-items:center;padding:22rpx 0;border-bottom:1rpx solid #F8F8F8}
.g-row:last-child{border-bottom:none}
.g-row.g-dim{opacity:.45}
.g-label{flex-shrink:0;width:150rpx;font-size:26rpx;font-weight:600}
.g-low{color:#2E8B57}
.g-mid{color:#B26A00}
.g-high{color:#E4393C}
.g-metrics{flex:1;min-width:0}
.g-main{font-size:30rpx;color:#333;margin-bottom:4rpx}
.g-main .up{color:#E4393C}
.g-main .down{color:#2E8B57}
.g-sub{font-size:22rpx;color:#999}

.method-card{margin:16rpx 24rpx 0;background:#FFF;border-radius:16rpx;padding:24rpx 28rpx}
.m-title{font-size:26rpx;font-weight:600;color:#333;margin-bottom:12rpx}
.m-line{font-size:22rpx;color:#999;line-height:1.7;margin-bottom:6rpx}

/* 温度回测：人话结论卡 + 对比条形图 */
.concl-card{margin:16rpx 24rpx 0;background:#FFF;border-radius:16rpx;padding:28rpx}
.concl-what{font-size:22rpx;color:#999;line-height:1.6;margin-bottom:14rpx}
.concl-big{font-size:34rpx;font-weight:700;color:#333;line-height:1.5;margin-bottom:10rpx}
.concl-horizon{font-size:22rpx;color:#BBB;font-weight:400}
.concl-sub{font-size:22rpx;color:#BBB}
.g-bar-wrap{height:16rpx;background:#F5F5F5;border-radius:8rpx;overflow:hidden;margin-bottom:8rpx}
.g-bar{height:100%;border-radius:8rpx;opacity:.75}
.g-bar.g-low{background:#2E8B57}
.g-bar.g-mid{background:#B26A00}
.g-bar.g-high{background:#E4393C}
.h-spread{font-size:24rpx;color:#333;background:#FAFAF5;border-radius:10rpx;padding:12rpx 16rpx;margin-top:8rpx}

/* ==================== 组合透视 ==================== */
/* 真实年化（XIRR）：大数字 + 同口径对照 */
.xr-main{display:flex;align-items:baseline;margin:8rpx 0 4rpx}
.xr-num{font-size:64rpx;font-weight:700;color:var(--primary)}
.xr-num.up{color:var(--up)}
.xr-num.down{color:var(--down)}
.xr-unit{font-size:24rpx;color:#999;margin-left:8rpx}
.xr-cmp{font-size:24rpx;color:#666;margin:8rpx 0;line-height:1.6}
.xr-facts{font-size:22rpx;color:#999;margin-bottom:8rpx}
/* 估算可信度：结论行 + 最准/最不准两行 */
.tr-line{font-size:26rpx;color:#333;line-height:1.7;margin-bottom:14rpx}
.tr-row{display:flex;align-items:center;padding:12rpx 0;border-top:1rpx solid #F5F5F5}
.tr-tag{flex-shrink:0;width:96rpx;font-size:20rpx;color:#888;background:#F2F2F2;border-radius:8rpx;padding:6rpx 0;text-align:center;margin-right:16rpx}
.tr-tag.tr-good{color:var(--primary)}
.tr-name{flex:1;min-width:0;font-size:24rpx;color:#333;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tr-val{flex-shrink:0;font-size:22rpx;color:#666;margin-left:16rpx}
/* 集中度：品种占比条形 + 行业提示 */
.cc-row{display:flex;align-items:center;padding:10rpx 0}
.cc-name{width:230rpx;font-size:24rpx;color:#333;flex-shrink:0;margin-right:16rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cc-bar-wrap{flex:1;height:14rpx;background:#F5F5F5;border-radius:7rpx;overflow:hidden}
.cc-bar{height:100%;background:var(--primary);opacity:.65;border-radius:7rpx}
.cc-pct{width:110rpx;text-align:right;font-size:24rpx;color:#333;flex-shrink:0}
.cc-ind{font-size:24rpx;color:#666;margin-top:12rpx;line-height:1.6}
.cc-warn{font-size:24rpx;color:#B26A00;background:#FFF7E8;border-radius:8rpx;padding:12rpx 16rpx;margin-top:12rpx;line-height:1.5}
.retry-link{color:var(--primary)}
