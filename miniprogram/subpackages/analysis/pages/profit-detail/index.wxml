<view class="page {{theme === 'red' ? 'theme-red' : 'theme-blue'}}">
  <view class="disclaimer">数据来源：公开市场数据，仅供参考，不构成投资建议。</view>
  <view wx:if="{{showBriefBanner}}" class="brief-banner">
    <text class="brief-banner-text">收盘播报 · 净值确认后通知你</text>
    <view class="brief-banner-btn" bind:tap="onBriefAuth">订阅</view>
    <view class="brief-banner-close" bind:tap="onBriefClose">×</view>
  </view>
  <view wx:if="{{showRecallOptOut}}" class="brief-banner">
    <text class="brief-banner-text">不想再收到此类持仓提醒？</text>
    <view class="brief-banner-btn" bind:tap="onRecallOptOut">关闭</view>
    <view class="brief-banner-close" bind:tap="onRecallOptOutClose">×</view>
  </view>
  <!-- JTBD 主 Job 验证（一次性）：回答或关闭都记 done，不再打扰 -->
  <view wx:if="{{showJtbdSurvey}}" class="brief-banner jtbd-survey">
    <text class="brief-banner-text">你打开韭菜估值宝，主要想解决什么？</text>
    <view class="jtbd-options">
      <view wx:for="{{jtbdOptions}}" wx:key="*this" class="jtbd-option" bind:tap="onJtbdAnswer" data-answer="{{item}}">{{item}}</view>
    </view>
    <view class="brief-banner-close" bind:tap="onJtbdDismiss">×</view>
  </view>
  <view wx:if="{{loading}}" class="loading-inline"><text class="loading-text">加载中...</text></view>
  <view wx:elif="{{loadError}}" class="empty-wrap">
    <view class="empty-icon">😵</view>
    <view class="empty-text">加载失败</view>
    <button class="retry-btn" bind:tap="onRetry">点击重试</button>
  </view>
  <block wx:elif="{{empty}}">
    <view class="empty-wrap">
      <view class="empty-icon">📉</view>
      <view class="empty-text">暂无收益数据</view>
      <view class="empty-hint">添加持仓后可查看收益走势</view>
      <button class="empty-btn" bind:tap="onGoHome">返回首页</button>
    </view>
  </block>

    <block wx:else>
	    <view wx:if="{{earliestDate}}" class="tip-inline">收益自 {{earliestDate}} 起计，随交易日积累</view>
		    <!-- 收益摘要：当天/本周/本月/本年 -->
		    <view class="summary-bar">
		      <view class="summary-item {{activeTab === 'today' ? 'active' : ''}}" bind:tap="onSummaryTap" data-tab="today">
		        <view class="summary-label">当天收益</view>
		        <view class="summary-value {{todayProfit > 0 ? 'up' : todayProfit < 0 ? 'down' : ''}}">
		          {{amountVisible ? (todayProfit > 0 ? '+' : '') + todayProfit : '****'}}
		        </view>
		        <view class="summary-rate {{todayProfitRate > 0 ? 'up' : todayProfitRate < 0 ? 'down' : ''}}">
		          {{todayProfitRate > 0 ? '+' : ''}}{{todayProfitRate}}%
		        </view>
		        <view wx:if="{{asOfTime}}" class="summary-asof">截至 {{asOfTime}}</view>
		      </view>
		      <view class="summary-item {{activeTab === 'week' ? 'active' : ''}}" bind:tap="onSummaryTap" data-tab="week">
        <view class="summary-label">本周收益</view>
        <view class="summary-value {{weekProfit > 0 ? 'up' : weekProfit < 0 ? 'down' : ''}}">
          {{!weekHasData ? '--' : (amountVisible ? (weekProfit > 0 ? '+' : '') + weekProfit : '****')}}
        </view>
        <view class="summary-rate {{weekProfitRate > 0 ? 'up' : weekProfitRate < 0 ? 'down' : ''}}">
          {{!weekHasData ? '--' : (weekProfitRate > 0 ? '+' : '') + weekProfitRate + '%'}}
        </view>
      </view>
      <view class="summary-item {{activeTab === 'month' ? 'active' : ''}}" bind:tap="onSummaryTap" data-tab="month">
        <view class="summary-label">本月收益</view>
        <view class="summary-value {{monthProfit > 0 ? 'up' : monthProfit < 0 ? 'down' : ''}}">
          {{!monthHasData ? '--' : (amountVisible ? (monthProfit > 0 ? '+' : '') + monthProfit : '****')}}
        </view>
        <view class="summary-rate {{monthProfitRate > 0 ? 'up' : monthProfitRate < 0 ? 'down' : ''}}">
          {{!monthHasData ? '--' : (monthProfitRate > 0 ? '+' : '') + monthProfitRate + '%'}}
        </view>
      </view>
      <view class="summary-item {{activeTab === 'year' ? 'active' : ''}}" bind:tap="onSummaryTap" data-tab="year">
        <view class="summary-label">本年收益</view>
        <view class="summary-value {{yearProfit > 0 ? 'up' : yearProfit < 0 ? 'down' : ''}}">
          {{!yearHasData ? '--' : (amountVisible ? (yearProfit > 0 ? '+' : '') + yearProfit : '****')}}
        </view>
        <view class="summary-rate {{yearProfitRate > 0 ? 'up' : yearProfitRate < 0 ? 'down' : ''}}">
          {{!yearHasData ? '--' : (yearProfitRate > 0 ? '+' : '') + yearProfitRate + '%'}}
        </view>
      </view>
    </view>

    <!-- 走势图 -->
    <view class="chart-card">
      <view class="chart-header">
        <view class="chart-title">{{activeTab === 'today' ? '当天' : activeTab === 'week' ? '本周' : activeTab === 'month' ? '本月' : '本年'}}走势</view>
        <view class="index-options">
          <view wx:for="{{availableIndices}}" wx:key="code" wx:for-item="idx"
            wx:if="{{idx.code !== '000300'}}"
            class="index-opt {{compareIndex === idx.code ? 'active' : ''}}"
            bind:tap="onSelectIndex" data-code="{{idx.code}}" data-name="{{idx.name}}">
            {{idx.name}}
          </view>
          <view class="index-opt {{compareIndex === '000300' ? 'active' : ''}}"
            bind:tap="onSelectIndex" data-code="000300" data-name="沪深300">
            沪深300
          </view>
        </view>
      </view>
      <view class="chart-canvas-wrap">
        <canvas type="2d" id="profitCanvas" style="width:100%;height:{{canvasHRpx}}rpx" bindtouchstart="onCanvasTouch" bindtouchmove="onCanvasTouch" bindtouchend="onCanvasTouch"></canvas>
        <view wx:if="{{todayChartLoading}}" class="chart-loading-mask"><text class="chart-loading-text">切换指数中…</text></view>
      </view>
      <view wx:if="{{activeTab === 'today' && asOfTime}}" class="dd-tip">数据截至 {{asOfTime}}</view>
      <view wx:if="{{activeTab !== 'today'}}" class="dd-tip">回撤 = 从历史最高点到当前的最大跌幅，衡量最坏情况下的亏损幅度</view>
    </view>

    <!-- 周期复盘条：组合 vs 沪深300 + 操作（随 tab 变化：今日/本周/本月/本年） -->
    <view wx:if="{{reviewCard}}" class="review-card">
      <view class="review-top">
        <view class="review-combo">
          <view class="review-cell">
            <view class="review-num {{reviewCard.comboRate > 0 ? 'up' : reviewCard.comboRate < 0 ? 'down' : ''}}">{{reviewCard.comboRate == null ? '--' : (reviewCard.comboRate > 0 ? '+' : '') + reviewCard.comboRate + '%'}}</view>
            <view class="review-label">{{reviewCard.tabLabel}}组合</view>
          </view>
          <block wx:if="{{reviewCard.hsRate != null}}">
            <view class="review-vs">vs</view>
            <view class="review-cell">
              <view class="review-num {{reviewCard.hsRate > 0 ? 'up' : reviewCard.hsRate < 0 ? 'down' : ''}}">{{reviewCard.hsRate > 0 ? '+' : ''}}{{reviewCard.hsRate}}%</view>
              <view class="review-label">沪深300</view>
            </view>
          </block>
        </view>
        <!-- 结论固定在卡片右上角 -->
        <view class="review-diff" wx:if="{{reviewCard.diffText}}">{{reviewCard.diffText}}</view>
      </view>
      <view class="review-line" wx:if="{{reviewCard.best}}">最强：{{reviewCard.best.name}} {{reviewCard.best.rate > 0 ? '+' : ''}}{{reviewCard.best.rate}}%</view>
      <view class="review-line" wx:if="{{reviewCard.worst}}">最弱：{{reviewCard.worst.name}} {{reviewCard.worst.rate > 0 ? '+' : ''}}{{reviewCard.worst.rate}}%</view>
      <view class="review-line" wx:if="{{reviewCard.opText}}">{{reviewCard.opText}}</view>
    </view>

    <!-- 签入口：周/月/年 tab 显示对应签（当天 tab 无签） -->
    <view wx:if="{{signVisible}}" class="weekly-entry-row">
      <text class="weekly-entry" bind:tap="onShowSignCard" data-period="{{activeTab}}">📈 生成本{{activeTab === 'week' ? '周' : activeTab === 'month' ? '月' : '年'}}签</text>
    </view>

    <!-- 盈亏日历 -->
    <view class="cal-top-row">
      <view class="cal-title">盈亏日历</view>
      <view class="cal-mode-toggle" bind:tap="onToggleMode">{{profitMode === 'amount' ? '收益率' : '收益金额'}}</view>
    </view>
    <view class="tab-bar">
        <view class="tab-item {{calendarView === 'day' ? 'active' : ''}}" bind:tap="onCalendarTab" data-tab="day">日</view>
        <view class="tab-item {{calendarView === 'week' ? 'active' : ''}}" bind:tap="onCalendarTab" data-tab="week">周</view>
        <view class="tab-item {{calendarView === 'month' ? 'active' : ''}}" bind:tap="onCalendarTab" data-tab="month">月</view>
        <view class="tab-item {{calendarView === 'year' ? 'active' : ''}}" bind:tap="onCalendarTab" data-tab="year">年</view>
        <view wx:if="{{calendarView === 'day' || calendarView === 'week'}}" class="tab-picker">
          <picker mode="selector" range="{{availableMonths}}" bindchange="onMonthChange">
            <view class="picker-label">{{selectedMonth}} ▼</view>
          </picker>
        </view>
        <view wx:if="{{calendarView === 'month'}}" class="tab-picker">
          <picker mode="selector" range="{{availableYears}}" bindchange="onYearChange">
            <view class="picker-label">{{selectedYear}} ▼</view>
          </picker>
        </view>
      </view>

    <!-- 日视图 -->
    <view wx:if="{{calendarView === 'day'}}" class="calendar-card">
      <view class="day-grid">
        <view class="weekday">日</view><view class="weekday">一</view><view class="weekday">二</view>
        <view class="weekday">三</view><view class="weekday">四</view><view class="weekday">五</view><view class="weekday">六</view>
        <block wx:for="{{dayCalendar}}" wx:for-item="row" wx:key="index">
          <view wx:for="{{row}}" wx:for-item="d" wx:for-index="di" wx:key="di"
            class="day-cell {{d.empty ? 'empty' : (d.profit > 0 ? 'up' : d.profit < 0 ? 'down' : '')}}">
            <view class="day-num">{{d.day}}</view>
            <view wx:if="{{!d.empty && d.profit !== null}}" class="day-profit {{d.profit > 0 ? 'up' : d.profit < 0 ? 'down' : ''}}">
              {{profitMode === 'rate' ? (d.rate > 0 ? '+' : '') + d.rate + '%' : (d.profit > 0 ? '+' : '') + d.profit}}
            </view>
          </view>
        </block>
      </view>
    </view>

    <!-- 周视图（与月视图同款网格） -->
    <view wx:if="{{calendarView === 'week'}}" class="calendar-card">
      <view class="month-grid">
        <view wx:for="{{weekCalendar}}" wx:key="ws" class="month-cell {{item.empty ? 'empty' : (item.profit > 0 ? 'up' : item.profit < 0 ? 'down' : '')}}">
          <view class="month-name">{{item.range}}</view>
          <view wx:if="{{!item.empty && item.profit !== null}}" class="month-profit {{item.profit > 0 ? 'up' : item.profit < 0 ? 'down' : ''}}">
            {{profitMode === 'rate' ? (item.rate > 0 ? '+' : '') + item.rate + '%' : (item.profit > 0 ? '+' : '') + item.profit}}
          </view>
          <view wx:else class="month-profit empty-text">--</view>
        </view>
      </view>
    </view>

    <!-- 月视图 -->
    <view wx:if="{{calendarView === 'month'}}" class="calendar-card">
      <view class="month-grid">
        <view wx:for="{{monthCalendar}}" wx:key="month" class="month-cell {{item.empty ? 'empty' : (item.profit > 0 ? 'up' : item.profit < 0 ? 'down' : '')}}">
          <view class="month-name">{{item.month}}月</view>
          <view wx:if="{{!item.empty && item.profit !== null}}" class="month-profit {{item.profit > 0 ? 'up' : item.profit < 0 ? 'down' : ''}}">
            {{profitMode === 'rate' ? (item.rate > 0 ? '+' : '') + item.rate + '%' : (item.profit > 0 ? '+' : '') + item.profit}}
          </view>
          <view wx:else class="month-profit empty-text">--</view>
        </view>
      </view>
    </view>

    <!-- 年视图 -->
    <view wx:if="{{calendarView === 'year'}}" class="calendar-card">
      <view class="year-list">
        <view wx:for="{{yearData}}" wx:key="date" class="year-row {{item.profit > 0 ? 'up' : item.profit < 0 ? 'down' : ''}}">
          <view class="year-label">{{item.date.slice(0, 4)}}年</view>
          <view class="year-profit {{item.profit > 0 ? 'up' : item.profit < 0 ? 'down' : ''}}">
            {{profitMode === 'rate' ? (item.rate > 0 ? '+' : '') + item.rate + '%' : (item.profit > 0 ? '+' : '') + item.profit}}
          </view>
        </view>
      </view>
    </view>
    </block>

    <!-- 周签弹层 -->
    <!-- 周期签弹层（周签/月签/年签） -->
    <view wx:if="{{showSignModal}}" class="idx-modal-mask" bind:tap="onSignClose">
      <view class="idx-modal" catch:tap="noop">
        <view class="idx-modal-head">
          <text class="idx-modal-title">{{signTitle}}</text>
          <view class="idx-modal-close" bind:tap="onSignClose">×</view>
        </view>
        <view wx:if="{{signRendering}}" class="mk-loading"><text class="mk-loading-text">生成中...</text></view>
        <block wx:else>
          <canvas type="2d" id="signCanvas" class="sign-canvas"></canvas>
          <view class="sign-actions">
            <button class="sign-save-btn" bind:tap="onSaveSign">保存到相册</button>
            <button class="sign-share-btn" open-type="share">分享给好友</button>
          </view>
        </block>
      </view>
    </view>
</view>
