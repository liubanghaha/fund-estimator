.page{min-height:100vh;background:#F5F5F5;padding-bottom:40rpx}

.loading-wrap{display:flex;align-items:center;justify-content:center;padding-top:200rpx}
.loading-text{font-size:28rpx;color:#999}

/* 骨架屏 */
.skeleton-wrap{padding:24rpx}
.sk-summary-bar{display:flex;gap:12rpx;margin-bottom:16rpx}
.sk-summary-item{flex:1;height:120rpx;border-radius:12rpx}
.sk-chart{height:360rpx;border-radius:20rpx;margin-bottom:16rpx}
.sk-tabbar{height:80rpx;border-radius:20rpx;margin-bottom:16rpx}
.sk-calendar{height:500rpx;border-radius:20rpx}

/* 空状态 */
.empty-wrap{display:flex;flex-direction:column;align-items:center;padding-top:160rpx}
.empty-icon{font-size:80rpx;margin-bottom:24rpx}
.empty-text{font-size:30rpx;color:#999;margin-bottom:12rpx}
.empty-hint{font-size:24rpx;color:#CCC;margin-bottom:48rpx}
.empty-btn{width:240rpx;height:72rpx;line-height:72rpx;font-size:26rpx;color:#FFF;background:var(--primary-gradient);border-radius:36rpx;text-align:center;padding:0}
.tip-inline{font-size:20rpx;color:#BBB;text-align:center;padding:8rpx 24rpx 4rpx}

.summary-bar{display:flex;background:#FFF;padding:16rpx 16rpx;margin-bottom:16rpx}
.summary-item{flex:1;text-align:center;padding:12rpx 4rpx;border-radius:12rpx;transition:all .2s;margin-right:6rpx}
.summary-item:last-child{margin-right:0}
.summary-item.active{background:rgba(25,118,210,.08)}
.summary-item.active .summary-label{color:var(--primary);font-weight:600}
.summary-item.active .summary-value{color:#333}
.summary-item.active .summary-value.up{color:var(--up)}
.summary-item.active .summary-value.down{color:#2E8B57}
.summary-label{font-size:20rpx;color:#999;margin-bottom:4rpx}
.summary-value{font-size:28rpx;font-weight:600;color:#333}
.summary-value.up{color:var(--up)}
.summary-value.down{color:#2E8B57}
.summary-rate{font-size:18rpx;color:#999;margin-top:2rpx}
.summary-asof{font-size:16rpx;color:#CCC;margin-top:2rpx}
.summary-rate.up{color:var(--up)}
.summary-rate.down{color:#2E8B57}
.summary-item.active .summary-rate{color:var(--primary)}
.summary-item.active .summary-rate.up{color:var(--up)}
.summary-item.active .summary-rate.down{color:#2E8B57}

.chart-card{background:#FFF;margin:16rpx 24rpx;border-radius:var(--radius-card);padding:24rpx 16rpx 16rpx}
.chart-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12rpx;padding-left:8rpx}
.chart-title{font-size:26rpx;font-weight:600;color:#1A1A1A}
.compare-picker{font-size:24rpx;color:var(--primary);padding:8rpx 16rpx;background:rgba(25,118,210,0.06);border-radius:8rpx}
.index-options{display:flex;gap:4rpx;flex-wrap:wrap}
.index-opt{font-size:20rpx;color:#999;padding:4rpx 10rpx;border-radius:16rpx;background:#F5F5F5}
.index-opt.active{color:var(--primary);background:rgba(25,118,210,0.08);font-weight:500}

.cal-top-row{display:flex;justify-content:space-between;align-items:center;background:#FFF;margin:0 24rpx;padding:20rpx 24rpx 8rpx;border-radius:20rpx 20rpx 0 0}
.cal-title{font-size:28rpx;font-weight:600;color:#1A1A1A}
.cal-mode-toggle{font-size:22rpx;color:var(--primary);padding:6rpx 16rpx;background:rgba(25,118,210,0.06);border-radius:16rpx}
.dd-tip{margin:0 24rpx;padding:2rpx 24rpx 12rpx;font-size:18rpx;color:#CCC;line-height:1.4}

.tab-bar{display:flex;align-items:center;gap:16rpx;background:#FFF;margin:0 24rpx;border-radius:0;padding:16rpx 24rpx;border-bottom:1rpx solid #F0F0F0}
.tab-item{font-size:26rpx;color:#999;padding:8rpx 16rpx;position:relative}
.tab-item.active{color:var(--primary);font-weight:600}
.tab-item.active::after{content:'';position:absolute;bottom:-17rpx;left:50%;transform:translateX(-50%);width:32rpx;height:4rpx;background:var(--primary);border-radius:2rpx}
.tab-picker{margin-left:auto}
.picker-label{font-size:24rpx;color:#666;padding:10rpx 14rpx;background:#F5F5F5;border-radius:8rpx}
.cal-header{display:flex;justify-content:center;padding:0 0 16rpx}
/* 日历 */
.calendar-card{background:#FFF;margin:0 24rpx;border-radius:0 0 20rpx 20rpx;padding:16rpx 16rpx 24rpx}

.day-grid{display:grid;grid-template-columns:repeat(7,1fr);padding:8rpx 0 12rpx}
.weekday{text-align:center;font-size:22rpx;color:#BBB;padding-bottom:12rpx}

.day-cell{text-align:center;padding:12rpx 2rpx;min-height:90rpx;display:flex;flex-direction:column;align-items:center;justify-content:center}
.day-profit{font-size:20rpx;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.day-cell.empty{opacity:.4}
.day-cell.empty .day-num{font-size:20rpx;color:#CCC}
.day-cell.up .day-num,.day-cell.down .day-num{font-size:26rpx;color:#333;font-weight:500}
.day-num{font-size:20rpx;color:#CCC;margin-bottom:2rpx}
.day-profit.up{color:var(--up)}
.day-profit.down{color:#2E8B57}

/* 月网格 */
.month-grid{display:flex;flex-wrap:wrap;padding:8rpx 0}
.month-cell{width:25%;text-align:center;padding:24rpx 0;display:flex;flex-direction:column;align-items:center;justify-content:center}
.month-cell.empty{opacity:.25}
.month-name{font-size:26rpx;color:#333;margin-bottom:8rpx}
.month-profit{font-size:24rpx;font-weight:500}
.month-profit.up{color:var(--up)}
.month-profit.down{color:#2E8B57}
.empty-text{font-size:24rpx;color:#CCC}

/* 年列表 */
.year-list{padding:8rpx 0}
.year-row{display:flex;justify-content:space-between;align-items:center;padding:24rpx 8rpx;border-bottom:1rpx solid #F5F5F5}
.year-row:last-child{border-bottom:none}
.year-label{font-size:30rpx;font-weight:500;color:#333}
.year-profit{font-size:30rpx;font-weight:600}
.year-profit.up{color:var(--up)}
.year-profit.down{color:#2E8B57}

/* 收盘播报订阅引导条 */
.brief-banner{display:flex;align-items:center;margin:16rpx 24rpx 0;padding:16rpx 20rpx;background:#FFF7E6;border-radius:12rpx}
.brief-banner-text{flex:1;font-size:24rpx;color:#8A6116}
.brief-banner-btn{margin:0 16rpx;padding:8rpx 26rpx;background:var(--primary);color:#fff;font-size:24rpx;border-radius:999rpx}
.brief-banner-close{padding:0 8rpx;color:#C8A96A;font-size:34rpx;line-height:1}

/* 切指数未命中预取时的图表区加载反馈（数据到位即消失，绘制带动画） */
.chart-canvas-wrap{position:relative}
.chart-loading-mask{position:absolute;left:0;top:0;right:0;bottom:0;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.55)}
.chart-loading-text{font-size:24rpx;color:#999}
/* JTBD 一次性问卷（复用 brief-banner 底色） */
.jtbd-survey{flex-direction:column;align-items:flex-start;gap:12rpx}
.jtbd-options{display:flex;flex-wrap:wrap;gap:12rpx}
.jtbd-option{font-size:24rpx;color:#666;background:#FFF;border:1rpx solid #E5E5E5;border-radius:24rpx;padding:8rpx 24rpx}
/* 影子账户（A2 最小版） */
.shadow-card{background:#FFF;border-radius:var(--radius-card);padding:24rpx;margin:16rpx 24rpx;box-shadow:var(--shadow-card)}
.shadow-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12rpx}
.shadow-title{font-size:28rpx;font-weight:700;color:#333}
.shadow-total{font-size:30rpx;font-weight:700}
.shadow-item{display:flex;align-items:center;justify-content:space-between;padding:12rpx 0;border-bottom:1rpx solid #F5F5F5}
.shadow-item:last-of-type{border-bottom:none}
.shadow-desc{font-size:24rpx;color:#666;flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.shadow-val{font-size:26rpx;font-weight:600;margin-left:16rpx}
.shadow-tip{font-size:20rpx;color:#BBB;margin-top:10rpx;line-height:1.5}
/* 周期复盘卡 */
.review-card{background:#FFF;border-radius:var(--radius-card);padding:24rpx;margin:16rpx 24rpx 20rpx;box-shadow:var(--shadow-card)}
.review-title{font-size:28rpx;font-weight:700;color:#333;margin-bottom:16rpx}
.review-combo{display:flex;align-items:center;gap:24rpx;margin-bottom:14rpx}
.review-cell{display:flex;flex-direction:column;align-items:center}
.review-num{font-size:38rpx;font-weight:700}
.review-label{font-size:20rpx;color:#BBB;margin-top:4rpx}
.review-vs{font-size:22rpx;color:#CCC}
.review-line{font-size:24rpx;color:#666;padding:6rpx 0}
/* 周签 */
.weekly-entry-row{display:flex;justify-content:flex-end;margin:0 24rpx 4rpx}
.weekly-entry{font-size:24rpx;color:var(--primary);padding:8rpx 12rpx}
.weekly-canvas{width:600rpx;height:880rpx;margin:0 auto}
.weekly-actions{display:flex;gap:20rpx;padding:20rpx 10rpx 8rpx}
.weekly-save-btn,.weekly-share-btn{flex:1;font-size:28rpx;border-radius:40rpx;line-height:2.6;padding:0}
.weekly-save-btn{color:#FFF;background:var(--primary)}
.weekly-share-btn{color:var(--primary);background:#FFF;border:1rpx solid var(--primary)}
/* 弹层复用（与行情页同款样式，跨页各自定义） */
.idx-modal-mask{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:1000;display:flex;align-items:center;justify-content:center}
.idx-modal{width:640rpx;background:#FFF;border-radius:20rpx;padding:28rpx 24rpx 16rpx}
.idx-modal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx}
.idx-modal-title{font-size:30rpx;font-weight:700;color:#333}
.idx-modal-close{font-size:40rpx;color:#CCC;padding:0 8rpx;line-height:1}
.idx-modal-canvas{width:100%;height:320rpx}
.idx-modal-foot{font-size:20rpx;color:#CCC;text-align:center;padding-top:12rpx}
.mk-loading{padding:80rpx 0;text-align:center}
.mk-loading-text{font-size:26rpx;color:#BBB}
.review-diff{font-size:22rpx;color:#888;background:#F8F8F8;border-radius:10rpx;padding:6rpx 14rpx}
.sign-canvas{width:600rpx;height:880rpx;margin:0 auto}
.sign-actions{display:flex;gap:20rpx;padding:20rpx 10rpx 8rpx}
.sign-save-btn,.sign-share-btn{flex:1;font-size:28rpx;border-radius:40rpx;line-height:2.6;padding:0}
.sign-save-btn{color:#FFF;background:var(--primary)}
.sign-share-btn{color:var(--primary);background:#FFF;border:1rpx solid var(--primary)}
