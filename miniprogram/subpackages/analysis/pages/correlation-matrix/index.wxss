.page-wrap{min-height:100vh;background:#F5F5F5;padding:16rpx 24rpx 40rpx}
.loading-text{text-align:center;padding:80rpx 0;font-size:28rpx;color:#BBB}
.empty{text-align:center;padding:80rpx 0;font-size:26rpx;color:#CCC}
.empty-wrap{display:flex;flex-direction:column;align-items:center;padding-top:160rpx}
.empty-text{font-size:30rpx;color:#999;margin-bottom:24rpx}
.retry-btn{width:240rpx;height:72rpx;line-height:72rpx;font-size:26rpx;color:var(--primary);background:#FFF;border:1rpx solid var(--primary);border-radius:36rpx;text-align:center;padding:0}
.empty-btn{margin-top:24rpx;width:280rpx;height:72rpx;line-height:72rpx;font-size:26rpx;color:#FFF;background:var(--primary-gradient);border-radius:36rpx;text-align:center;padding:0}

.card{background:#FFF;border-radius:var(--radius-card);padding:24rpx;margin-bottom:16rpx;box-shadow:var(--shadow-card);}
.card-title{font-size:28rpx;font-weight:600;color:#333;margin-bottom:20rpx}
.card-desc{font-weight:400;font-size:22rpx;color:#BBB}

/* 健康分 */
.health-main{display:flex;align-items:center;position:relative}
.health-canvas{width:140rpx;height:140rpx;flex-shrink:0}
.health-ring-wrap{position:relative;width:140rpx;height:140rpx;flex-shrink:0}
.health-canvas{width:140rpx;height:140rpx}
.health-score{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-size:36rpx;font-weight:700;color:var(--primary);pointer-events:none}
.health-right{flex:1;padding-left:24rpx}
.health-grade{font-size:28rpx;font-weight:600;color:#333;margin-bottom:6rpx}
/* 涨跌色（红涨绿跌，与全站一致；.health-grade.* 另有专属配色不受影响） */
.up{color:var(--up)}
.down{color:#2E8B57}
.health-grade.up{color:#2E8B57}
.health-grade.down{color:var(--up)}
.health-detail{font-size:24rpx;color:#666;margin-bottom:12rpx}
.health-bars{}
.health-bar-item{display:flex;align-items:center;margin-top:8rpx}
.hb-label{width:110rpx;font-size:22rpx;color:#999}
.hb-track{flex:1;height:12rpx;background:#EEE;border-radius:6rpx;overflow:hidden;margin:0 12rpx}
.hb-fill{height:100%;background:var(--primary);border-radius:6rpx;transition:width .5s}
.hb-val{font-size:22rpx;color:#666;width:48rpx;text-align:right}

/* 行业穿透 */
.asset-row{display:flex;align-items:center;padding:12rpx 0;border-bottom:1rpx solid #F5F5F5}
.asset-row:last-child{border-bottom:none}
.asset-name{font-size:26rpx;color:#333;width:140rpx;flex-shrink:0}
.asset-pct{font-size:24rpx;color:var(--primary);width:80rpx;text-align:right;flex-shrink:0}
.asset-bar{flex:1;height:12rpx;background:#F0F0F0;border-radius:6rpx;overflow:hidden;margin-left:16rpx}
.asset-fill{height:100%;background:linear-gradient(90deg,var(--primary),var(--primary));border-radius:6rpx;min-width:4rpx}
.asset-warning{margin-top:12rpx;padding:12rpx 16rpx;background:#FFF8E1;border-radius:8rpx;font-size:22rpx;color:#B8860B;line-height:1.5}

.expand-toggle{text-align:center;padding:12rpx 0;font-size:22rpx;color:#999}

/* 重合持仓股 */
.shared-section{}
.card-subtitle{font-size:24rpx;color:#999;margin-bottom:12rpx}
.shared-item{display:flex;justify-content:space-between;align-items:center;padding:12rpx 0;border-bottom:1rpx solid #F5F5F5}
.shared-item:last-child{border-bottom:none}
.shared-left{display:flex;align-items:center;flex:1;min-width:0}
.shared-name{font-size:26rpx;color:#333;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.shared-arrow{font-size:18rpx;color:#CCC;margin-left:8rpx;flex-shrink:0;transition:transform .2s}
.shared-arrow.open{transform:rotate(180deg)}
.shared-count{font-size:22rpx;color:var(--up);background:#FFF0F0;padding:4rpx 12rpx;border-radius:8rpx;flex-shrink:0;margin-left:12rpx}
.shared-funds{margin:0 0 12rpx 8rpx;padding:8rpx 16rpx;background:#FAFAFA;border-radius:8rpx}
.shared-fund-item{display:flex;justify-content:space-between;padding:8rpx 0;border-bottom:1rpx solid #F0F0F0}
.shared-fund-item:last-child{border-bottom:none}
.sfi-name{font-size:24rpx;color:#666}
.sfi-ratio{font-size:24rpx;color:var(--primary);font-weight:500}

/* 基金对重合 */
.corr-item{display:flex;align-items:center;padding:18rpx 0;border-bottom:1rpx solid #F5F5F5}
.corr-item:last-child{border-bottom:none}
.corr-names{width:280rpx;flex-shrink:0;display:flex;align-items:center}
.corr-name{font-size:26rpx;color:#333;max-width:120rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.corr-vs{font-size:20rpx;color:#CCC;margin:0 6rpx;flex-shrink:0}
.corr-right{flex:1;display:flex;align-items:center;margin-left:12rpx}
.corr-bar-track{flex:1;height:8rpx;background:#F0F0F0;border-radius:4rpx;overflow:hidden;margin-right:12rpx}
.corr-bar-fill{height:100%;border-radius:4rpx}
.corr-bar-fill.high{background:var(--up)}
.corr-bar-fill.mid{background:#FF9800}
.corr-bar-fill.low{background:#4CAF50}
.corr-val{font-size:28rpx;font-weight:700;width:72rpx;text-align:right;flex-shrink:0}
.corr-val.high{color:var(--up)}
.corr-val.mid{color:#FF9800}
.corr-val.low{color:#4CAF50}
.corr-tag{flex-shrink:0;margin-left:8rpx;padding:2rpx 10rpx;font-size:20rpx;background:#FFF0F0;color:var(--up);border-radius:6rpx}
.legend{display:flex;justify-content:center;gap:20rpx;margin-top:16rpx;padding-top:12rpx;border-top:1rpx solid #F5F5F5}
.legend-item{display:flex;align-items:center;gap:6rpx;font-size:20rpx;color:#999}
.legend-dot{width:14rpx;height:14rpx;border-radius:3rpx}
.legend-dot.high{background:var(--up)}
.legend-dot.mid{background:#FF9800}
.legend-dot.low{background:#4CAF50}
/* 行业集中度提示 */
.conc-tip{font-size:22rpx;color:#8a6d3b;background:#FCF4E3;border-radius:10rpx;padding:12rpx 16rpx;margin-bottom:14rpx;line-height:1.5}

/* ===== 费用账单 / 影子账户（hero 块 + 明细行） ===== */
.hero-block{background:#F7F8FA;border-radius:16rpx;padding:28rpx 24rpx;margin-bottom:8rpx}
.hero-label{font-size:22rpx;color:#999;margin-bottom:10rpx}
.hero-num{font-size:56rpx;font-weight:700;color:var(--primary);line-height:1.15;letter-spacing:-1rpx}
.hero-num.up{color:var(--up)}
.hero-num.down{color:#2E8B57}
.hero-sub{font-size:22rpx;color:#999;margin-top:10rpx}

/* 费用构成行：名称/费率 + 相对条 + 金额 */
.fee-list-title{font-size:24rpx;color:#666;font-weight:600;margin:22rpx 0 6rpx}
.fee-list-note{font-size:20rpx;color:#BBB;font-weight:400;margin-left:10rpx}
.fee-row{padding:16rpx 0;border-bottom:1rpx solid #F5F5F5}
.fee-row:last-of-type{border-bottom:none}
.fee-row-top{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:10rpx}
.fee-row-name{font-size:26rpx;color:#333;flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fee-row-rate{font-size:26rpx;color:#333;font-weight:600;margin-left:16rpx}
.fee-row-bottom{display:flex;align-items:center;gap:16rpx}
.fee-track{flex:1;height:10rpx;background:#F0F0F0;border-radius:5rpx;overflow:hidden}
.fee-fill{height:100%;background:var(--primary);border-radius:5rpx;opacity:.75}
.fee-row-fee{font-size:22rpx;color:#999;min-width:150rpx;text-align:right}
.card-footnote{font-size:20rpx;color:#BBB;margin-top:14rpx;line-height:1.6}

/* 影子明细行：日期徽标 + 名称/份额 + 金额 + 箭头 */
.shadow-row{display:flex;align-items:center;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid #F5F5F5}
.shadow-row:last-of-type{border-bottom:none}
.shadow-date{font-size:22rpx;color:#999;background:#F2F3F5;border-radius:8rpx;padding:6rpx 12rpx;flex-shrink:0}
.shadow-main{flex:1;min-width:0}
.shadow-name{font-size:26rpx;color:#333;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.shadow-meta{font-size:20rpx;color:#BBB;margin-top:4rpx}
.shadow-val{font-size:28rpx;font-weight:700;flex-shrink:0}
.shadow-arrow{font-size:28rpx;color:#CCC;flex-shrink:0}

/* Tab：持仓分析 | 费用与复盘（与详情页 tab-bar 同款） */
/* 横向不设 margin：页容器 .page-wrap 已有 24rpx padding，再加会让 tab 比卡片窄 */
.tab-bar{display:flex;background:#EDEEF0;margin:0 0 16rpx;border-radius:16rpx;padding:6rpx;box-sizing:border-box}
.tab-item{flex:1;text-align:center;padding:16rpx 0;font-size:26rpx;color:#888;border-radius:12rpx;transition:all .2s}
.tab-item.active{background:#FFF;color:var(--primary);font-weight:600;box-shadow:0 2rpx 8rpx rgba(0,0,0,.06)}
.empty-hint{font-size:22rpx;color:#BBB;margin-top:10rpx;line-height:1.6}
