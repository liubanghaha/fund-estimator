<view class="page-wrap {{theme === 'red' ? 'theme-red' : 'theme-blue'}}">
  <view class="disclaimer">数据来源：公开市场数据，仅供参考，不构成投资建议。</view>
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-text">正在分析持仓重合度，可能需要几秒…</view>

  <!-- 失败重试 -->
  <view wx:elif="{{loadError}}" class="empty-wrap">
    <view class="empty-text">加载失败</view>
    <button class="retry-btn" bind:tap="onRetry">点击重试</button>
  </view>

  <!-- 内容 -->
  <view wx:else>
    <!-- Tab：持仓分析（健康/穿透/重合） | 费用与复盘（费用账单/影子账户） -->
    <view class="tab-bar">
      <view class="tab-item {{activeTab === 'holding' ? 'active' : ''}}" bind:tap="onTabTap" data-tab="holding">持仓分析</view>
      <view class="tab-item {{activeTab === 'cost' ? 'active' : ''}}" bind:tap="onTabTap" data-tab="cost">账单</view>
    </view>

    <!-- ===== Tab 1：持仓分析 ===== -->
    <view hidden="{{activeTab !== 'holding'}}">
    <!-- 1. 持仓健康分 -->
    <view wx:if="{{healthScore}}" class="card">
      <view class="card-title">📊 持仓健康分</view>
      <view class="health-main">
        <view class="health-ring-wrap">
          <canvas type="2d" id="healthCanvas" class="health-canvas"></canvas>
          <text class="health-score">{{healthScore.score}}</text>
        </view>
        <view class="health-right">
          <view class="health-grade {{healthScore.grade === '优秀' ? 'up' : healthScore.grade === '较差' ? 'down' : ''}}">{{healthScore.grade}}</view>
          <view class="health-detail">温度{{healthScore.avgNormPE != null ? (healthScore.avgNormPE < 0.7 ? '偏低' : healthScore.avgNormPE < 1.3 ? '适中' : '偏高') : '--'}} · 最大行业 {{healthScore.maxIndustry}}%</view>
          <view class="health-bars">
            <view class="health-bar-item"><text class="hb-label">温度</text><view class="hb-track"><view class="hb-fill" style="width:{{healthScore.tempScore}}%"></view></view><text class="hb-val">{{healthScore.tempScore}}</text></view>
            <view class="health-bar-item"><text class="hb-label">行业分散</text><view class="hb-track"><view class="hb-fill" style="width:{{healthScore.concScore}}%"></view></view><text class="hb-val">{{healthScore.concScore}}</text></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 2. 温度位置（持仓温度 vs 全市场当日分布；数据不全时整卡不显示） -->
    <view wx:if="{{tempStatMine}}" class="card">
      <view class="card-title">🌡 温度位置</view>
      <view class="temp-stat">{{tempStatMine}}</view>
      <view wx:if="{{tempStatMarket}}" class="temp-stat">{{tempStatMarket}}</view>
    </view>

    <!-- 2. 持仓穿透 -->
    <view wx:if="{{assetAllocation && assetAllocation.items.length > 0}}" class="card">
      <view class="card-title">🏭 行业穿透<text wx:if="{{assetAllocation.coverage != null}}" style="float:right;font-size:20rpx;color:#BBB;font-weight:400;line-height:1.5">覆盖持仓 {{assetAllocation.coverage}}%</text></view>
      <view wx:if="{{concentrationTip}}" class="conc-tip">⚠️ {{concentrationTip}}</view>
      <view wx:for="{{assetAllocation.items}}" wx:key="industry" wx:if="{{index < 10 || showAllIndustries}}" class="asset-row">
        <text class="asset-name">{{item.industry}}</text>
        <text class="asset-pct">{{item.percent}}%</text>
        <view class="asset-bar"><view class="asset-fill" style="width:{{item.percent}}%"></view></view>
      </view>
      <view wx:if="{{assetAllocation.items.length > 10}}" class="expand-toggle" bind:tap="toggleIndustries">
        {{showAllIndustries ? '收起' : '展开更多 (' + (assetAllocation.items.length - 10) + '项)'}}
      </view>
      <view wx:if="{{assetAllocation.warning}}" class="asset-warning">⚠️ {{assetAllocation.warning}}</view>
    </view>

    <!-- 3. 持仓重合度 -->
    <view wx:if="{{pairs.length > 0}}" class="card">
      <view class="card-title">🔗 持仓重合度
        <text class="card-desc">（本季度前十大持仓对比）</text>
      </view>

      <!-- 重合股票 -->
      <view wx:if="{{sharedStocks.length > 0}}" class="shared-section">
        <view class="card-subtitle">重合持仓股</view>
        <block wx:for="{{sharedStocks}}" wx:key="stockCode">
          <view class="shared-item" bind:tap="onToggleSharedStock" data-index="{{index}}">
            <view class="shared-left">
              <text class="shared-name">{{item.stockName}}（{{item.stockCode}}）</text>
              <text class="shared-arrow {{item._open ? 'open' : ''}}">{{item._open ? '▼' : '▶'}}</text>
            </view>
            <text class="shared-count">{{item.fundCount}}只基金持有</text>
          </view>
          <view wx:if="{{item._open}}" class="shared-funds">
            <view wx:for="{{item.funds}}" wx:key="fundCode" wx:for-item="f" class="shared-fund-item">
              <text class="sfi-name">{{f.fundName || f.fundCode}}</text>
              <text class="sfi-ratio">{{f.ratio}}%</text>
            </view>
          </view>
        </block>
      </view>

      <!-- 基金对重合（空状态占位，已移除功能） -->
    </view>

    <!-- 3.5 组合回本进度（陪伴线，2026-11 调研增补）：成本口径与首页收益卡同源（市值−累计收益） -->
    <view wx:if="{{breakeven}}" class="card">
      <view class="card-title">💰 回本进度<text class="card-desc">（全组合）</text></view>
      <view class="bk-main">
        <text class="bk-pct {{breakeven.state === 'surplus' ? 'up' : ''}}">{{breakeven.pct}}%</text>
        <text class="bk-label">{{breakeven.state === 'surplus' ? '当前市值 / 投入本金，已回本' : '当前市值 / 投入本金'}}</text>
      </view>
      <view class="bk-track"><view class="bk-fill {{breakeven.state === 'surplus' ? 'surplus' : ''}}" style="width:{{breakeven.fillW}}%"></view></view>
      <view class="bk-sub" wx:if="{{breakeven.state === 'deficit'}}">距回本还需上涨 {{breakeven.needRise}}%</view>
      <view class="bk-sub" wx:else>已超过本金 {{breakeven.surplusPct}}%</view>
      <view class="bk-sub" wx:if="{{amountVisible}}">本金 ¥{{breakeven.costText}} · 现值 ¥{{breakeven.mvText}}</view>
    </view>

    <view wx:if="{{!healthScore && (!assetAllocation || !assetAllocation.items) && pairs.length === 0}}" class="empty">
      <view>暂无持仓分析数据</view>
      <button class="empty-btn" bind:tap="onGoHome">去添加持仓</button>
    </view>
    </view>

    <!-- ===== Tab 2：费用与复盘 ===== -->
    <view hidden="{{activeTab !== 'cost'}}">
    <!-- 费用账单（自收益页迁入：成本结构属深度洞察） -->
    <view wx:if="{{feeCard}}" class="card">
      <view class="card-title">💸 费用账单</view>
      <view class="hero-block">
        <view class="hero-label">预计年持有费用</view>
        <view class="hero-num">{{amountVisible ? ('¥' + feeCard.annualFee) : '¥****'}}</view>
        <view class="hero-sub">综合费率 {{feeCard.totalRate}}%/年 · 按 {{feeCard.fundCount}} 只持仓市值估算</view>
      </view>
      <view class="fee-list-title">各持仓费率（费率降序）<text wx:if="{{feeCard.hasSales}}" class="fee-list-note">含销售服务费</text></view>
      <view class="fee-row" wx:for="{{feeCard.items}}" wx:key="fundName">
        <view class="fee-row-top">
          <text class="fee-row-name">{{item.fundName}}</text>
          <text class="fee-row-rate">{{item.rate}}%</text>
        </view>
        <view class="fee-row-bottom">
          <view class="fee-track"><view class="fee-fill" style="width:{{item.barPct}}%"></view></view>
          <text class="fee-row-fee">约 {{amountVisible ? item.fee : '****'}} 元/年</text>
        </view>
      </view>
      <view wx:if="{{feeTotalCount > 3}}" class="show-more" bind:tap="onToggleFeeAll">{{feeShowAll ? '收起' : '展开全部 ' + feeTotalCount + ' 只'}}</view>
      <view class="card-footnote">收益为名义口径，未扣除上述持有费用；费率取自基金公告，不含申赎费用</view>
    </view>

    <!-- 行为成本（按年分组：操作概览/归因分布/赎回费演算，年度报告 hero 同源） -->
    <view wx:if="{{billCard && billCard.years.length}}" class="card">
      <view class="card-title">🧾 行为成本<text class="card-sub">按年 · 按公告费率估算</text><text wx:if="{{billHasRows}}" class="bill-cal" bind:tap="onCalibrateBill">按实际账单校准</text></view>

      <view class="year-group" wx:for="{{billCard.years}}" wx:for-item="y" wx:for-index="yi" wx:key="year">
        <view class="yg-head">
          <text class="yg-year">{{y.year}} 年</text>
          <text class="yg-ops">{{y.trades.total}} 次操作（买 {{y.trades.buy}} / 卖 {{y.trades.sell}}）</text>
        </view>

        <view wx:if="{{y.redemption.rows.length > 0}}" class="hero-block">
          <view class="hero-label">赎回费估算</view>
          <view class="hero-num">¥{{y.redemption.total}}</view>
          <view class="hero-sub">卖出 {{y.trades.sell}} 笔<text wx:if="{{y.redemption.shortCount > 0}}"> · 其中短持 {{y.redemption.shortCount}} 笔 {{y.redemption.shortFee}} 元</text><text wx:if="{{y.redemption.calibratedCount > 0}}"> · {{y.redemption.calibratedCount}} 笔已按实际校准</text></view>
        </view>

        <view class="fee-list-title">操作归因<text class="fee-list-note" wx:if="{{y.untagged > 0}}">未记录 {{y.untagged}} 笔</text></view>
        <block wx:if="{{y.reasons.length > 0}}">
          <view class="reason-row" wx:for="{{y.reasons}}" wx:key="reason" wx:for-item="g">
            <text class="reason-name">{{g.reason}}</text>
            <view class="reason-track"><view class="reason-fill" style="width:{{g.pct}}%"></view></view>
            <text class="reason-count">{{g.count}} 笔</text>
          </view>
        </block>
        <view wx:else class="reason-empty">操作时未记录归因</view>

        <block wx:if="{{y.redemption.rows.length > 0}}">
          <view class="fee-list-title">赎回费明细<text class="fee-list-note">按持有天数套费率分档 · 先进先出</text></view>
          <view class="fee-row" wx:for="{{y.displayRows}}" wx:key="index" wx:for-item="r">
            <view class="fee-row-top">
              <text class="fee-row-name">{{r.fundName}}</text>
              <text class="fee-row-fee {{r.feeCls}}">{{r.feeText}}</text>
            </view>
            <view class="fee-row-bottom">
              <text class="fee-row-meta">{{r.date}} 卖出 · 持有 {{r.holdDays}} 天<text wx:if="{{r.short}}"> · 短持惩罚档</text></text>
            </view>
          </view>
          <view wx:if="{{y.rowsTotal > 3}}" class="show-more" bind:tap="onExpandYear" data-index="{{yi}}">{{y.expanded ? '收起' : '展开全部 ' + y.rowsTotal + ' 笔'}}</view>
        </block>
      </view>

      <view class="card-footnote">按公告费率×持有天数估算（先进先出，不含申购费；持有超过免费期的不计费）。平台优惠、基金转换、后端收费等实际费用以交易确认单为准。仅回顾事实，不构成任何建议</view>
    </view>

    <!-- 校准弹层：按平台实际账单逐笔修正赎回费（留空 = 回到估算） -->
    <view wx:if="{{showBillCal}}" class="cal-mask" bind:tap="onBillCalCancel">
      <view class="cal-card" catch:tap>
        <view class="cal-title">按实际账单校准</view>
        <view class="cal-desc">填入平台实际扣除的赎回费，留空表示按公告费率估算</view>
        <scroll-view scroll-y class="cal-scroll">
          <view class="cal-item" wx:for="{{billCalRows}}" wx:key="txId">
            <view class="cal-item-info">
              <view class="cal-item-name">{{item.fundName}}</view>
              <view class="cal-item-meta">{{item.meta}}</view>
            </view>
            <view class="cal-item-input">
              <input type="digit" value="{{item.value}}" placeholder="{{item.placeholder}}" data-index="{{index}}" bindinput="onBillCalInput" />
              <text class="cal-item-unit">元</text>
            </view>
          </view>
        </scroll-view>
        <view class="cal-btns">
          <button class="cal-btn ghost" bind:tap="onBillCalCancel">取消</button>
          <button class="cal-btn primary" bind:tap="onBillCalSave" loading="{{billCalSaving}}" disabled="{{billCalSaving}}">保存</button>
        </view>
      </view>
    </view>

    <!-- 影子账户（自收益页迁入：行为复盘属深度洞察） -->
    <view wx:if="{{showShadowCard}}" class="card">
      <view class="card-title">🔄 影子账户</view>
      <view class="hero-block">
        <view class="hero-label">卖出的部分，如果一直没卖</view>
        <view class="hero-num {{shadowTotal > 0 ? 'up' : shadowTotal < 0 ? 'down' : ''}}" wx:if="{{shadowTotal != null}}">{{amountVisible ? (shadowTotal > 0 ? '+' : '') + shadowTotal + ' 元' : '****'}}</view>
      </view>
      <view class="shadow-row" wx:for="{{shadowTop}}" wx:key="dateShort" data-code="{{item.fundCode}}" data-name="{{item.fundName}}" bind:tap="onShadowFundTap">
        <view class="shadow-date">{{item.dateShort}}</view>
        <view class="shadow-main">
          <view class="shadow-name">{{item.fundName}}</view>
          <view class="shadow-meta">卖出 {{item.shares}} 份</view>
        </view>
        <view class="shadow-val {{item.shadow > 0 ? 'up' : item.shadow < 0 ? 'down' : ''}}">{{amountVisible ? (item.shadow > 0 ? '+' : '') + item.shadow : '****'}}</view>
        <view class="shadow-arrow">›</view>
      </view>
      <view class="card-footnote">演算口径：卖出份额 ×（最新净值 − 卖出净值），不含分红；仅回顾事实，不构成投资建议</view>
    </view>

    <view wx:if="{{!feeCard && !showShadowCard && !billCard}}" class="empty">
      <view>暂无费用与复盘数据</view>
      <view class="empty-hint">持有基金后可查看费用账单；有过卖出记录后会生成影子账户</view>
      <button class="empty-btn" bind:tap="onGoHome">去添加持仓</button>
    </view>
    </view>
  </view>
</view>
