<view class="page-wrap {{theme === 'red' ? 'theme-red' : 'theme-blue'}}">
  <view class="disclaimer">数据来源：公开市场数据，仅供参考，不构成投资建议。</view>
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-text">正在分析持仓重合度，可能需要几秒…</view>

  <!-- 失败重试 -->
  <view wx:elif="{{loadError}}" class="empty-wrap">
    <view class="empty-text">加载失败</view>
    <button class="retry-btn" bind:tap="onRetry">点击重试</button>
  </view>

  <!-- 内容 -->
  <view wx:else>
    <!-- 1. 持仓健康分 -->
    <view wx:if="{{healthScore}}" class="card">
      <view class="card-title">📊 持仓健康分</view>
      <view class="health-main">
        <view class="health-ring-wrap">
          <canvas type="2d" id="healthCanvas" class="health-canvas"></canvas>
          <text class="health-score">{{healthScore.score}}</text>
        </view>
        <view class="health-right">
          <view class="health-grade {{healthScore.grade === '优秀' ? 'up' : healthScore.grade === '较差' ? 'down' : ''}}">{{healthScore.grade}}</view>
          <view class="health-detail">温度{{healthScore.avgNormPE != null ? (healthScore.avgNormPE < 0.7 ? '偏低' : healthScore.avgNormPE < 1.3 ? '适中' : '偏高') : '--'}} · 最大行业 {{healthScore.maxIndustry}}%</view>
          <view class="health-bars">
            <view class="health-bar-item"><text class="hb-label">温度</text><view class="hb-track"><view class="hb-fill" style="width:{{healthScore.tempScore}}%"></view></view><text class="hb-val">{{healthScore.tempScore}}</text></view>
            <view class="health-bar-item"><text class="hb-label">行业分散</text><view class="hb-track"><view class="hb-fill" style="width:{{healthScore.concScore}}%"></view></view><text class="hb-val">{{healthScore.concScore}}</text></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 2. 持仓穿透 -->
    <view wx:if="{{assetAllocation && assetAllocation.items.length > 0}}" class="card">
      <view class="card-title">🏭 行业穿透<text wx:if="{{assetAllocation.coverage != null}}" style="float:right;font-size:20rpx;color:#BBB;font-weight:400;line-height:1.5">覆盖持仓 {{assetAllocation.coverage}}%</text></view>
      <view wx:if="{{concentrationTip}}" class="conc-tip">⚠️ {{concentrationTip}}</view>
      <view wx:for="{{assetAllocation.items}}" wx:key="industry" wx:if="{{index < 10 || showAllIndustries}}" class="asset-row">
        <text class="asset-name">{{item.industry}}</text>
        <text class="asset-pct">{{item.percent}}%</text>
        <view class="asset-bar"><view class="asset-fill" style="width:{{item.percent}}%"></view></view>
      </view>
      <view wx:if="{{assetAllocation.items.length > 10}}" class="expand-toggle" bind:tap="toggleIndustries">
        {{showAllIndustries ? '收起' : '展开更多 (' + (assetAllocation.items.length - 10) + '项)'}}
      </view>
      <view wx:if="{{assetAllocation.warning}}" class="asset-warning">⚠️ {{assetAllocation.warning}}</view>
    </view>

    <!-- 3. 持仓重合度 -->
    <view wx:if="{{pairs.length > 0}}" class="card">
      <view class="card-title">🔗 持仓重合度
        <text class="card-desc">（本季度前十大持仓对比）</text>
      </view>

      <!-- 重合股票 -->
      <view wx:if="{{sharedStocks.length > 0}}" class="shared-section">
        <view class="card-subtitle">重合持仓股</view>
        <block wx:for="{{sharedStocks}}" wx:key="stockCode">
          <view class="shared-item" bind:tap="onToggleSharedStock" data-index="{{index}}">
            <view class="shared-left">
              <text class="shared-name">{{item.stockName}}（{{item.stockCode}}）</text>
              <text class="shared-arrow {{item._open ? 'open' : ''}}">{{item._open ? '▼' : '▶'}}</text>
            </view>
            <text class="shared-count">{{item.fundCount}}只基金持有</text>
          </view>
          <view wx:if="{{item._open}}" class="shared-funds">
            <view wx:for="{{item.funds}}" wx:key="fundCode" wx:for-item="f" class="shared-fund-item">
              <text class="sfi-name">{{f.fundName || f.fundCode}}</text>
              <text class="sfi-ratio">{{f.ratio}}%</text>
            </view>
          </view>
        </block>
      </view>

      <!-- 基金对重合（空状态占位，已移除功能） -->
    </view>

    <!-- 费用账单（自收益页迁入：成本结构属深度洞察） -->
    <view wx:if="{{feeCard}}" class="card">
      <view class="card-title">💸 费用账单</view>
      <view class="fee-head-row">
        <text class="fee-rate-big">{{feeCard.totalRate}}%</text>
        <text class="fee-rate-label">综合费率 / 年</text>
      </view>
      <view class="fee-main">按当前 {{feeCard.fundCount}} 只持仓，每年支付管理费+托管费<text wx:if="{{feeCard.hasSales}}">（含销售服务费）</text>约 <text class="fee-num">{{amountVisible ? feeCard.annualFee : '****'}} 元</text></view>
      <view class="fee-item" wx:for="{{feeCard.items}}" wx:key="fundName">
        <text class="fee-item-name">{{item.fundName}}</text>
        <text class="fee-item-val">{{item.rate}}%/年 · 约 {{amountVisible ? item.fee : '****'}} 元</text>
      </view>
      <view class="fee-note">当前收益为名义收益，未扣除上述持有费用；费率取自基金公告，不含申赎费用</view>
    </view>

    <!-- 影子账户（自收益页迁入：行为复盘属深度洞察） -->
    <view wx:if="{{showShadowCard}}" class="card">
      <view class="card-title-row">
        <text class="card-title" style="margin-bottom:0">🔄 影子账户 · 如果没卖</text>
        <text class="shadow-total {{shadowTotal > 0 ? 'up' : shadowTotal < 0 ? 'down' : ''}}" wx:if="{{shadowTotal != null}}">{{amountVisible ? (shadowTotal > 0 ? '+' : '') + shadowTotal + '元' : '****'}}</text>
      </view>
      <view class="shadow-item" wx:for="{{shadowTop}}" wx:key="dateShort" data-code="{{item.fundCode}}" data-name="{{item.fundName}}" bind:tap="onShadowFundTap">
        <text class="shadow-desc">{{item.dateShort}}卖出的 {{item.fundName}}（{{item.shares}}份）</text>
        <text class="shadow-val {{item.shadow > 0 ? 'up' : item.shadow < 0 ? 'down' : ''}}">{{amountVisible ? (item.shadow > 0 ? '+' : '') + item.shadow + '元' : '****'}}</text>
      </view>
      <view class="fee-note">演算口径：卖出份额 ×（最新净值 − 卖出净值），不含分红；仅回顾事实，不构成任何操作建议</view>
    </view>

    <view wx:if="{{!healthScore && (!assetAllocation || !assetAllocation.items) && pairs.length === 0}}" class="empty">
      <view>暂无数据</view>
      <button class="empty-btn" bind:tap="onGoHome">去添加持仓</button>
    </view>
  </view>
</view>
