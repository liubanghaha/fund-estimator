.container{padding:24rpx}
.user-header{display:flex;flex-direction:column;align-items:center;padding:60rpx 0 40rpx;background:#FFF;border-radius:16rpx;margin-bottom:24rpx}
.avatar-btn{width:120rpx;height:120rpx;padding:0;margin:0 0 20rpx 0;border:none;background:transparent;display:flex;align-items:center;justify-content:center}
.avatar-btn::after{border:none}
.avatar{width:120rpx;height:120rpx;border-radius:50%}
.avatar-placeholder{width:120rpx;height:120rpx;line-height:120rpx;text-align:center;font-size:80rpx;border-radius:50%;background:#F0F0F0}
.nickname-tip{font-size:24rpx;color:#999;margin-bottom:8rpx}
.nickname{font-size:32rpx;color:#333}
.menu-group-title{font-size:22rpx;color:#BBB;margin:0 32rpx 10rpx;padding-left:8rpx}
.menu-list{background:#FFF;border-radius:var(--radius-card);margin-bottom:24rpx;box-shadow:var(--shadow-card);}
.menu-item{display:flex;justify-content:space-between;align-items:center;padding:32rpx;font-size:30rpx;border-bottom:1rpx solid #F0F0F0}
.menu-item:last-child{border-bottom:none}
.arrow{color:#CCC}
.account-row{align-self:stretch;display:flex;align-items:center;justify-content:center;gap:12rpx;margin:32rpx 40rpx 0;padding-top:26rpx;border-top:1rpx solid #F0F0F0;font-size:26rpx}
.account-label{color:#BBB}
.account-value{color:#07C160}
.account-value.unsynced{color:#E4393C}
.account-arrow{color:#CCC}

/* ========== 反馈表单 ========== */
/* 就地展开的表单：挂在对应菜单行下面（此前三张表单都堆在页面最底部，点完还得往下找） */
.menu-expand{padding:20rpx 24rpx 28rpx;border-top:1rpx solid #F0F0F0;background:#FFF}

.fb-section{margin-bottom:28rpx}
.fb-label{font-size:28rpx;color:#333;font-weight:500;margin-bottom:14rpx}

/* 类型选择 */
.fb-type-row{display:flex;gap:16rpx}
.fb-type-item{flex:1;text-align:center;padding:18rpx 0;font-size:26rpx;color:#666;background:#F5F5F5;border-radius:12rpx;border:2rpx solid transparent;transition:all .2s}
.fb-type-item.active{color:var(--primary);background:var(--primary-bg);border-color:var(--primary)}

/* 联系方式 */
.fb-input{width:100%;height:80rpx;padding:0 20rpx;font-size:28rpx;background:#F5F5F5;border-radius:12rpx;box-sizing:border-box}

/* 描述 */
.fb-textarea{width:100%;min-height:180rpx;font-size:28rpx;padding:16rpx 20rpx;background:#F5F5F5;border-radius:12rpx;box-sizing:border-box;line-height:1.6}
.fb-count{text-align:right;font-size:22rpx;color:#BBB;margin-top:8rpx}

/* 图片上传 */
.fb-images{display:flex;flex-wrap:wrap;gap:16rpx}
.fb-img-item{position:relative;width:160rpx;height:160rpx;border-radius:12rpx;overflow:hidden}
.fb-img{width:100%;height:100%}
.fb-img-del{position:absolute;top:0;right:0;width:40rpx;height:40rpx;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.5);border-radius:0 12rpx 0 12rpx;color:#FFF;font-size:28rpx;line-height:1}
.fb-img-add{width:160rpx;height:160rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#F5F5F5;border-radius:12rpx;border:2rpx dashed #DDD}
.fb-img-add-icon{font-size:48rpx;color:#CCC;line-height:1}
.fb-img-add-text{font-size:22rpx;color:#BBB;margin-top:4rpx}

/* 操作按钮 */
.fb-actions{display:flex;justify-content:flex-end;gap:20rpx;margin-top:8rpx}
.fb-cancel,.fb-submit{padding:16rpx 40rpx;font-size:28rpx;border-radius:10rpx;line-height:1.4}
.fb-cancel{background:#F5F5F5;color:#666}
.fb-submit{background:var(--primary);color:#FFF}
.fb-submit[disabled]{opacity:.6}

.ver-mask{position:fixed;top:0;left:0;right:0;bottom:0;z-index:1000;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center}
.ver-card{width:580rpx;max-height:75vh;background:#FFF;border-radius:var(--radius-card);display:flex;flex-direction:column;overflow:hidden}
.ver-title{font-size:34rpx;font-weight:700;color:#333;text-align:center;padding:36rpx 24rpx 4rpx;flex-shrink:0}
.ver-version{font-size:24rpx;color:#BBB;text-align:center;margin-bottom:16rpx;flex-shrink:0}
.ver-body{flex:1;padding:0 32rpx;overflow-y:auto;min-height:0;-webkit-overflow-scrolling:touch}
.ver-block{margin-bottom:20rpx}
.ver-block-title{font-size:26rpx;font-weight:600;color:#333;margin-bottom:10rpx}
.ver-item{font-size:26rpx;color:#555;line-height:2;padding-left:4rpx}
.ver-close{margin:16rpx 32rpx 28rpx;text-align:center;background:var(--primary-gradient);color:#FFF;border-radius:44rpx;padding:18rpx 0;font-size:30rpx;flex-shrink:0}

/* 数据迁移 */
.migrate-input{min-height:auto;height:88rpx;text-align:center;font-size:34rpx;letter-spacing:8rpx;text-transform:lowercase}
.migrate-tip{font-size:24rpx;color:#999;margin:16rpx 4rpx;line-height:1.6}
.migrate-btn{margin-top:20rpx;background:var(--primary);color:#FFF;font-size:30rpx;border-radius:44rpx;padding:18rpx 0}
.migrate-btn[disabled]{opacity:.6;color:#FFF}

/* 关注公众号：滚动提示条（点一下复制号名，小程序里不能直接跳公众号） */
.follow-bar{display:flex;align-items:center;gap:12rpx;margin:0 24rpx 20rpx;padding:16rpx 20rpx;background:#FFF7F0;border:1rpx solid #F5D6B8;border-radius:14rpx;overflow:hidden}
.follow-icon{flex-shrink:0;font-size:28rpx}
.follow-marquee{flex:1;min-width:0;overflow:hidden;white-space:nowrap}
.follow-text{display:inline-block;padding-left:100%;font-size:24rpx;color:#B4642E;animation:followScroll 16s linear infinite}
@keyframes followScroll{from{transform:translateX(0)}to{transform:translateX(-100%)}}
.follow-cta{flex-shrink:0;font-size:23rpx;color:#FFF;background:#E4393C;border-radius:10rpx;padding:8rpx 18rpx}

/* 关注公众号二维码弹层 */
.follow-qr-mask{position:fixed;top:0;left:0;right:0;bottom:0;z-index:1000;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center}
.follow-qr-card{width:580rpx;background:#FFF;border-radius:var(--radius-card);display:flex;flex-direction:column;align-items:center;overflow:hidden;padding-bottom:12rpx}
.follow-qr-title{font-size:34rpx;font-weight:700;color:#333;text-align:center;padding:36rpx 24rpx 24rpx}
.follow-qr-img{width:400rpx}
.follow-qr-action{font-size:28rpx;color:#E4393C;margin-top:24rpx}
.follow-qr-tip{font-size:24rpx;color:#999;margin:12rpx 40rpx 0;text-align:center;line-height:1.6}
.follow-qr-copy{font-size:24rpx;color:#576B95;margin-top:20rpx}
.follow-qr-close{margin:26rpx 32rpx 28rpx;align-self:stretch;text-align:center;background:var(--primary-gradient);color:#FFF;border-radius:44rpx;padding:18rpx 0;font-size:30rpx}

/* 添加到桌面 / 添加到我的小程序 引导弹层 */
.addg-mask{position:fixed;top:0;left:0;right:0;bottom:0;z-index:1000;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center}
.addg-card{width:600rpx;background:#FFF;border-radius:var(--radius-card);overflow:hidden}
.addg-title{font-size:34rpx;font-weight:700;color:#333;text-align:center;padding:36rpx 24rpx 4rpx}
.addg-capsule-wrap{display:flex;flex-direction:column;align-items:flex-end;margin:20rpx 40rpx 28rpx}
.addg-hint{font-size:22rpx;color:#E4393C;margin:0 16rpx 6rpx 0}
.addg-capsule{display:flex;align-items:center;gap:20rpx;padding:10rpx 26rpx;border:2rpx solid #DDD;border-radius:36rpx;background:#FAFAFA}
.addg-dots{font-size:34rpx;color:#333;letter-spacing:2rpx;line-height:1.2}
.addg-ring{width:32rpx;height:32rpx;border:3rpx solid #333;border-radius:50%;position:relative}
.addg-ring::after{content:'';position:absolute;top:6rpx;left:6rpx;width:14rpx;height:14rpx;background:#333;border-radius:50%}
.addg-steps{margin:0 40rpx}
.addg-step{display:flex;align-items:flex-start;gap:14rpx;margin-bottom:16rpx}
.addg-step-n{flex-shrink:0;width:34rpx;height:34rpx;line-height:34rpx;text-align:center;border-radius:50%;background:var(--primary-bg);color:var(--primary);font-size:22rpx}
.addg-step-t{flex:1;font-size:27rpx;color:#444;line-height:1.5}
.addg-tip{font-size:23rpx;color:#999;margin:8rpx 40rpx 28rpx;line-height:1.6}
.addg-close{margin:0 32rpx 28rpx;text-align:center;background:var(--primary-gradient);color:#FFF;border-radius:44rpx;padding:18rpx 0;font-size:30rpx}
.addg-done{margin:28rpx 40rpx 8rpx;text-align:center;font-size:30rpx;color:#07C160;font-weight:500}
.addg-done-tip{margin:0 40rpx 28rpx;text-align:center;font-size:24rpx;color:#999;line-height:1.6}
