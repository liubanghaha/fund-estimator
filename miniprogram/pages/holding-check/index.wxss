.container{padding:24rpx 24rpx 160rpx}
.center-state{padding:120rpx 32rpx 60rpx;display:flex;flex-direction:column;align-items:center}
.empty-icon{font-size:80rpx;line-height:1;margin-bottom:20rpx}
.empty-title{font-size:30rpx;color:#666;margin-bottom:8rpx}
.empty-tip{font-size:24rpx;color:#BBB}

/* 摘要卡片 */
.summary-card{display:flex;align-items:center;gap:20rpx;background:#FFF;border-radius:var(--radius-card);box-shadow:var(--shadow-card);padding:36rpx 32rpx;margin-bottom:24rpx}
.summary-icon{font-size:56rpx;line-height:1}
.summary-title{font-size:34rpx;font-weight:600;color:#333}
.summary-sub{font-size:24rpx;color:#999;margin-top:6rpx}
.summary-card.pass .summary-title{color:var(--color-green)}

/* 问题条目 */
.issue-item{background:#FFF;border-radius:var(--radius-card);box-shadow:var(--shadow-card);padding:28rpx;margin-bottom:20rpx}
.issue-head{display:flex;align-items:center;gap:12rpx}
.issue-tag{font-size:20rpx;color:#FFF;background:#E4393C;border-radius:6rpx;padding:4rpx 12rpx;flex-shrink:0}
.tag-duplicate{background:#FF9800}
.tag-mismatch{background:#FF9800}
.tag-noestimate{background:#909399}
.issue-name{flex:1;font-size:30rpx;font-weight:500;color:#333;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.issue-code{font-size:24rpx;color:#BBB;flex-shrink:0}
.issue-desc{font-size:26rpx;color:#666;line-height:1.6;margin-top:14rpx}
.issue-meta{font-size:22rpx;color:#BBB;line-height:1.5;margin-top:8rpx;word-break:break-all}
.calibrate-btn{display:inline-block;margin-top:16rpx;font-size:26rpx;color:var(--primary);background:var(--primary-bg);border-radius:32rpx;padding:12rpx 32rpx}

/* 底部固定说明 */
.fixed-note{position:fixed;left:0;right:0;bottom:0;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));background:rgba(245,245,245,.96);font-size:22rpx;color:#999;text-align:center;line-height:1.6}
