.page{min-height:100vh;background:#F5F5F5;overflow-x:hidden}

.loading-wrap{display:flex;align-items:center;justify-content:center;padding-top:200rpx}
.loading-text{font-size:28rpx;color:#999}

/* 骨架屏 */
.skeleton-wrap{padding:16rpx 24rpx}
.sk-item{height:100rpx;border-radius:16rpx;margin-bottom:12rpx}

.empty-wrap{display:flex;flex-direction:column;align-items:center;padding-top:200rpx}
.empty-icon{font-size:80rpx;margin-bottom:24rpx}
.empty-text{font-size:30rpx;color:#999;margin-bottom:12rpx}
.empty-hint{font-size:24rpx;color:#CCC;margin-bottom:32rpx}
.search-btn,.add-fund-btn{width:280rpx;height:72rpx;line-height:72rpx;font-size:28rpx;color:#FFF;background:var(--primary-gradient);border-radius:36rpx;text-align:center;padding:0}
.add-fund-btn{margin-bottom:24rpx;width:240rpx;height:72rpx;font-size:26rpx;color:#FFF;background:var(--primary-gradient);border-radius:36rpx;display:flex;align-items:center;justify-content:center;padding:0}

/* 分组标签栏 */
.group-tabs-wrap{padding:16rpx 0 4rpx;background:#FFF}
.group-tabs{display:flex;white-space:nowrap;padding:0 24rpx}
.group-tab{display:inline-block;font-size:24rpx;color:#999;padding:10rpx 22rpx;border-radius:20rpx;background:#F5F5F5;margin-right:12rpx;flex-shrink:0;line-height:1.4}
.group-tab.active{color:#FFF;background:var(--primary);font-weight:500}
.group-tab.dragging{box-shadow:0 4rpx 16rpx rgba(0,0,0,.2);transform:scale(1.08);opacity:.9}
.group-tab-add{width:56rpx;text-align:center;padding:10rpx 0;color:#CCC;font-size:26rpx;font-weight:300}
.update-time{text-align:right;font-size:20rpx;color:#CCC;padding:4rpx 24rpx 0}

/* 搜索栏 */
.search-bar{display:flex;align-items:center;margin:12rpx 24rpx;background:#FFF;border-radius:12rpx;padding:0 16rpx;gap:8rpx}
.search-input{flex:1;height:64rpx;font-size:26rpx;min-width:0}
.search-clear{font-size:28rpx;color:#CCC;padding:0 4rpx;flex-shrink:0}
.search-sort-btn{font-size:24rpx;color:var(--primary);padding:6rpx 16rpx;border-radius:14rpx;background:var(--primary-bg);flex-shrink:0;white-space:nowrap}
.search-sort-btn-only{font-size:24rpx;color:var(--primary);padding:6rpx 16rpx;border-radius:14rpx;background:var(--primary-bg);margin-left:auto}

/* 列表项时间 */
.item-time{font-size:20rpx;color:#CCC;margin-top:2rpx}

/* 列表项上的分组标签 */
.group-tag{display:inline-block;font-size:18rpx;color:var(--primary);background:var(--primary-bg);border-radius:4rpx;padding:0 8rpx;margin-left:8rpx;vertical-align:middle;line-height:1.6}

.list{padding:12rpx 24rpx calc(120rpx + env(safe-area-inset-bottom))}
.item-wrap{position:relative;overflow:hidden;border-radius:16rpx;margin-bottom:12rpx}
.item{display:flex;justify-content:space-between;align-items:center;background:#FFF;padding:24rpx 24rpx;border-radius:16rpx;position:relative;z-index:1;transition:transform .2s}
.swipe-del-btn{position:absolute;right:0;top:0;bottom:0;width:120px;display:flex;align-items:center;justify-content:center;background:var(--up);color:#FFF;font-size:26rpx;border-radius:0 16rpx 16rpx 0}
.item-left{flex:1;min-width:0}
.item-name{font-size:30rpx;font-weight:500;color:#333;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.item-code{font-size:22rpx;color:#BBB;margin-top:4rpx}
.item-right{text-align:right;flex-shrink:0}
.item-rate{font-size:30rpx;font-weight:600;color:#999}
.item-rate.up{color:var(--up)}
.item-rate.down{color:#2E8B57}
.item-nav{font-size:24rpx;color:#999;margin-top:6rpx}
/* 估算值「估」角标（与分组标签同风格，区分估算值与已确认净值） */
.est-mark{display:inline-block;font-size:18rpx;color:var(--primary);background:var(--primary-bg);border-radius:4rpx;padding:0 8rpx;margin-left:8rpx;vertical-align:middle;line-height:1.6}

/* 批量模式 */
.batch-item{padding-left:16rpx}
.item-check{width:40rpx;height:40rpx;border:2rpx solid #CCC;border-radius:20rpx;margin-right:16rpx;display:flex;align-items:center;justify-content:center;font-size:22rpx;color:#FFF;flex-shrink:0}
.item-check.checked{background:var(--primary);border-color:var(--primary)}
.batch-bar{position:fixed;left:0;right:0;bottom:0;z-index:100;display:flex;justify-content:flex-end;align-items:center;gap:16rpx;padding:16rpx 24rpx;padding-bottom:calc(16rpx + env(safe-area-inset-bottom));background:#FFF;box-shadow:0 -2rpx 12rpx rgba(0,0,0,.04);flex-wrap:wrap}
.batch-time{font-size:22rpx;color:#BBB;margin-right:auto}
/* 轮询失败标记（同首页 .stale-badge），点击手动重试 */
.stale-badge{font-size:20rpx;color:var(--up);margin-left:8rpx}
.batch-edit-btn{font-size:26rpx;color:var(--up);padding:8rpx 20rpx}
.batch-select-all{font-size:26rpx;color:#666;padding:8rpx 20rpx}
.batch-move-btn{font-size:26rpx;color:var(--primary);padding:8rpx 28rpx;border-radius:28rpx;background:var(--primary-bg)}
.batch-delete-btn{font-size:26rpx;color:#FFF;background:var(--up);padding:8rpx 28rpx;border-radius:28rpx}
.batch-cancel-btn{font-size:26rpx;color:#999;padding:8rpx 20rpx}

/* 涨跌汇总条 */
.summary-bar{display:flex;align-items:center;gap:24rpx;margin:8rpx 24rpx;padding:12rpx 20rpx;background:#FFF;border-radius:10rpx}
.summary-item{font-size:24rpx;color:#999}
.summary-avg{font-weight:600}
.summary-avg.up{color:var(--up)}
.summary-avg.down{color:#2E8B57}
.summary-up{color:var(--up)}
.summary-down{color:#2E8B57}

/* 置顶标识 */
.pin-mark{font-size:24rpx;margin-right:4rpx}



/* 温度异动摘要条（只在有档位变化时渲染；边距对齐 summary-bar） */
.temp-strip{display:flex;align-items:center;flex-wrap:wrap;row-gap:4rpx;margin:0 24rpx 8rpx;padding:12rpx 20rpx;background:#FFF8F0;border-radius:10rpx}
.ts-label{font-size:24rpx;color:#B26A00;font-weight:600;margin-right:8rpx}
.ts-sep{font-size:22rpx;color:#CCC}
.ts-fund{font-size:22rpx;color:#333;max-width:220rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ts-move{font-size:22rpx;color:#999}
.ts-move.up{color:var(--up)}
.ts-move.down{color:#2E8B57}

/* 行内温度档位小圆点（名字前 3px 级，不加列；颜色与温度语义一致：绿=低温 黄=适中 红=高温） */
.temp-dot{display:inline-block;width:12rpx;height:12rpx;border-radius:50%;margin-right:6rpx;vertical-align:middle}
.temp-dot-low{background:#2E8B57}
.temp-dot-mid{background:#F2A93B}
.temp-dot-high{background:#E4393C}

/* ===== 区间收益表（持仓列表同款：名称列 sticky 固定，数据列横向滑动） ===== */
.table-scroll{width:100%}
.table-inner{display:inline-block;min-width:100%}
.t-row{display:flex;align-items:stretch;border-bottom:1rpx solid #EFEFEF;background:#FFF}
.t-row:last-child{border-bottom:none}
.t-row.selected{outline:3rpx solid var(--primary);outline-offset:-3rpx}
.t-cell{padding:20rpx 12rpx;display:flex;flex-direction:column;justify-content:center;box-sizing:border-box;flex-shrink:0;background:#FFF}
.t-head .t-cell{font-size:22rpx;color:#BBB;flex-direction:row;justify-content:flex-end;align-items:center;white-space:nowrap}
.t-name{width:300rpx;align-items:flex-start;overflow:hidden;position:sticky;left:0;z-index:1}
.t-head .t-name{justify-content:flex-start}
.t-cell:not(.t-name){width:170rpx;align-items:flex-end}
.name-text{font-size:26rpx;font-weight:500;color:#333;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:100%}
.code-text{font-size:20rpx;color:#999;display:flex;align-items:center;gap:8rpx;margin-top:4rpx}
.pct{font-size:26rpx;font-weight:600;color:#333}
.pct.up{color:var(--up)}
.pct.down{color:#2E8B57}
.temp-cell{font-size:20rpx}
.temp-cell-low{color:#2E8B57}
.temp-cell-mid{color:#F2A93B}
.temp-cell-high{color:#E4393C}
.temp-cell-none{color:#CCC}
.sort-active{color:var(--primary)}
.sort-arrow{font-size:18rpx;margin-left:2rpx}
.t-head .t-cell.sort-active{color:var(--primary)}
.sort-icon{font-size:18rpx;margin-left:2rpx;color:#CCC}
.sort-arrow{color:var(--primary)}

/* 今日估算列与名称列一同冻结（sticky 连续偏移：名称 300 + 估算 160） */
.t-cell.t-est{width:160rpx;position:sticky;left:300rpx;z-index:1}
.ts-close{margin-left:auto;font-size:24rpx;color:#CCC;padding:0 4rpx}
