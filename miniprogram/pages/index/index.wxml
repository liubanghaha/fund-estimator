<wxs module="fmt">
  // 金额千分位：1234567.89 → "1,234,567.89"（保留 2 位；WXS 不支持正则字面量，用循环）
  function money(v, withSign) {
    var n = parseFloat(v);
    if (isNaN(n)) return "--";
    var sign = withSign && n > 0 ? "+" : "";
    var neg = n < 0 ? "-" : "";
    var s = Math.abs(n).toFixed(2).split(".");
    var intPart = s[0];
    var grouped = "";
    var count = 0;
    for (var i = intPart.length - 1; i >= 0; i--) {
      grouped = intPart[i] + grouped;
      count++;
      if (count % 3 === 0 && i > 0) grouped = "," + grouped;
    }
    return sign + neg + grouped + "." + s[1];
  }
  module.exports = { money: money };
</wxs>
<view class="page-wrap {{theme === 'red' ? 'theme-red' : 'theme-blue'}}" style="height: {{pageHeight}}px">
  <scroll-view
    scroll-y
    class="page-scroll"
    refresher-enabled
    refresher-background="#F5F5F5"
    refresher-triggered="{{refresherTriggered}}"
    bindrefresherrefresh="onScrollRefresh"
  >
    <view class="container" style="padding-bottom: {{indexBarHeight}}rpx">

      <view class="disclaimer">数据来源：公开市场数据，仅供参考，不构成投资建议。</view>

      <!-- 分享落地横幅：被分享者点开看到分享者的持仓摘要，引导添加自己的持仓 -->
      <view wx:if="{{shareCard}}" class="share-landing">
        <view class="share-landing-top">
          <text class="share-landing-title">📤 {{shareCard.nickName}} 的持仓</text>
          <text class="share-landing-close" bind:tap="onCloseShareLanding">✕</text>
        </view>
        <view class="share-landing-row">
          <text class="share-landing-item">今日收益 <text class="{{shareCard.todayProfit > 0 ? 'up' : shareCard.todayProfit < 0 ? 'down' : ''}}">{{fmt.money(shareCard.todayProfit, true)}}</text></text>
          <text class="share-landing-item">持有 {{shareCard.fundCount}} 只</text>
          <text class="share-landing-item" wx:if="{{shareCard.totalReturn}}">累计 {{fmt.money(shareCard.totalReturn, true)}}</text>
        </view>
        <view class="share-landing-funds" wx:if="{{shareCard.fundNames.length > 0}}">
          <text class="share-landing-fund" wx:for="{{shareCard.fundNames}}" wx:key="code" wx:for-item="f">{{f.name}}</text>
        </view>
        <button class="share-landing-btn" bind:tap="onAddMyHolding">我也要算我的收益</button>
      </view>

      <view wx:if="{{alertTriggered.length > 0}}" class="alert-bar">
        <text class="alert-icon">🔔</text>
        <text class="alert-text" wx:if="{{alertTriggered[0].peChange}}">{{alertTriggered[0].fundName}} {{alertTriggered[0].peChange}}<text wx:if="{{alertTriggered.length > 1}}"> 等{{alertTriggered.length}}项</text></text>
        <text class="alert-text" wx:else>{{alertTriggered[0].fundName}} {{alertTriggered[0].type === 'up' ? '涨超' : '跌超'}}提醒<text wx:if="{{alertTriggered.length > 1}}"> 等{{alertTriggered.length}}项</text></text>
        <text class="alert-close" bind:tap="onDismissAlert">✕</text>
      </view>
      <view wx:if="{{!dataReady && !loadError}}" class="loading-inline"><text class="loading-text">加载中...</text></view>

      <view wx:elif="{{loadError}}" class="empty-state">
        <view class="empty-icon">🔌</view>
        <view class="empty-desc">网络异常，请检查网络后重试</view>
        <view class="empty-btns">
          <button class="login-btn" bind:tap="onScrollRefresh">点击重试</button>
        </view>
      </view>

      <!-- 未登录：优先于无持仓引导展示 -->
      <view wx:elif="{{!isLoggedIn}}" class="empty-state">
        <view class="empty-desc">登录后同步你的持仓与分组</view>
        <view class="empty-btns">
          <button class="login-btn" bind:tap="onGoLogin">去登录</button>
        </view>
      </view>

      <view wx:elif="{{holdings.length === 0}}" class="empty-state">
        <view class="empty-desc">添加你的第一笔持仓，开始追踪收益</view>
        <view class="empty-hint">支持APP持仓截图导入或手动搜索添加</view>
        <text class="empty-demo-sub-tip">识别结果可能有偏差，请核对后保存</text>
        <view class="empty-btns">
          <button class="login-btn" bind:tap="onScreenshotAdd">📷 截图添加</button>
          <button class="login-btn secondary" bind:tap="onSearch">🔍 搜索添加</button>
        </view>
      </view>

      <view wx:else class="dashboard">
        <!-- 吸顶区：账户栏 / 收益卡 / 快捷入口（含批量栏）/ 分组栏。下滑时只滚下面的列表 -->
        <view class="sticky-top">
        <!-- 平台栏（一级维度）：账户汇总 / 全部 / 各平台 / + 新建 / ☰ 管理。放在页面最顶部，资产卡显示当前平台合计 -->
        <view class="platform-bar">
          <scroll-view class="platform-tabs" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="platform-tab {{activePlatform === 'summary' ? 'active' : ''}}" bind:tap="onPlatformSwitch" data-platform="summary">账户汇总</view>
            <view class="platform-tab {{activePlatform === 'all' ? 'active' : ''}}" bind:tap="onPlatformSwitch" data-platform="all">全部</view>
            <block wx:for="{{platformList}}" wx:key="*this">
              <view
                class="platform-tab {{activePlatform === item ? 'active' : ''}} {{dragIndex === index ? 'dragging' : ''}}"
                style="{{dragIndex === index ? 'transform:translateX(' + dragX + 'px);z-index:10' : ''}}"
                bind:tap="onPlatformSwitch"
                bind:touchstart="onGroupTouchStart"
                bind:touchmove="onGroupTouchMove"
                bind:touchend="onGroupTouchEnd"
                data-platform="{{item}}"
                data-field="platform"
                data-index="{{index}}"
              >{{item}}</view>
            </block>
            <view class="platform-tab platform-add" bind:tap="onAddPlatform">＋</view>
          </scroll-view>
          <view class="tabs-search" bind:tap="onSearch">🔍</view>
        </view>

        <view class="asset-overview" bind:tap="onTapProfit">
          <view class="share-toggle" catch:tap="onShareCard"><text class="share-toggle-icon">📤</text> 分享</view>
          <view class="amount-toggle" catch:tap="onToggleAmount">{{amountVisible ? '隐藏' : '显示'}}</view>
          <view class="asset-label">今日估算收益<text wx:if="{{allUpdated}}" class="updated-badge">✓</text></view>
          <view class="asset-value {{amountVisible ? (cardSummary ? (cardSummary.todayProfit > 0 ? 'up' : cardSummary.todayProfit < 0 ? 'down' : '') : (todayProfit > 0 ? 'up' : todayProfit < 0 ? 'down' : '')) : ''}}">
            {{amountVisible ? (cardSummary ? fmt.money(cardSummary.todayProfit, true) : fmt.money(todayProfit, true)) : '****'}}
          </view>
          <view class="asset-sub">
            <text class="asset-sub-item">涨幅<text class="asset-sub-num">{{cardSummary ? (cardSummary.todayProfitRate == null ? '--' : (cardSummary.todayProfitRate > 0 ? '+' : '') + cardSummary.todayProfitRate + '%') : (todayProfitRate == null ? '--' : (todayProfitRate > 0 ? '+' : '') + todayProfitRate + '%')}}</text></text>
            <text class="asset-sub-item">市值<text class="asset-sub-num">{{amountVisible ? (cardSummary ? fmt.money(cardSummary.totalAmount) : fmt.money(totalAmount)) : '****'}}</text></text>
            <text class="asset-sub-item">累计<text class="asset-sub-num {{amountVisible ? (cardSummary ? (cardSummary.totalReturn > 0 ? 'up' : cardSummary.totalReturn < 0 ? 'down' : '') : (totalReturn > 0 ? 'up' : totalReturn < 0 ? 'down' : '')) : ''}}">{{amountVisible ? (cardSummary ? fmt.money(cardSummary.totalReturn, true) : fmt.money(totalReturn, true)) : '****'}}</text></text>
          </view>
        </view>

        <view wx:if="{{batchMode}}" class="batch-top-bar">
          <text class="batch-top-cancel" bind:tap="onToggleBatch">取消</text>
          <text class="batch-top-title">已选 {{selectedCount}} 项</text>
          <view class="batch-top-right">
            <text class="batch-top-link" bind:tap="onOpenColEdit">列设置</text>
            <text wx:if="{{!allSelected}}" class="batch-top-link" bind:tap="onSelectAll">全选</text>
            <text wx:else class="batch-top-link" bind:tap="onSelectAll">取消全选</text>
            <text class="batch-top-link" bind:tap="onBatchMoveToGroup">移动分组</text>
            <text class="batch-top-delete" bind:tap="onBatchDelete">删除</text>
          </view>
        </view>
        <view wx:if="{{batchMode}}" class="batch-alert-bar">
          <text class="batch-alert-label">选中基金提醒 · 未设过的按 ±3%</text>
          <view class="pe-switch {{batchAlertOn ? 'on' : ''}}" bind:tap="onBatchAlertToggle">
            <view class="pe-switch-dot"></view>
          </view>
        </view>

        <!-- 基金分组栏（在平台范围之内再筛） -->
        <view wx:if="{{holdings.length > 0 && activePlatform !== 'summary'}}" class="group-tabs-wrap">
          <scroll-view class="group-tabs" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="group-tab {{activeGroup === 'all' ? 'active' : ''}}" bind:tap="onGroupTap" data-group="all">全部<text class="group-tab-n">{{groupCounts.all || 0}}</text></view>
            <view class="group-tab {{activeGroup === 'ungrouped' ? 'active' : ''}}" bind:tap="onGroupTap" data-group="ungrouped">未分组<text class="group-tab-n">{{groupCounts.ungrouped || 0}}</text></view>
            <block wx:for="{{groups}}" wx:key="*this">
              <view
                class="group-tab {{activeGroup === item ? 'active' : ''}} {{dragIndex === index ? 'dragging' : ''}}"
                style="{{dragIndex === index ? 'transform:translateX(' + dragX + 'px);z-index:10' : ''}}"
                bind:tap="onGroupTap"
                bind:touchstart="onGroupTouchStart"
                bind:touchmove="onGroupTouchMove"
                bind:touchend="onGroupTouchEnd"
                data-group="{{item}}"
                data-index="{{index}}"
              >{{item}}<text class="group-tab-n">{{groupCounts[item] || 0}}</text></view>
            </block>
            <view class="group-tab group-tab-add" bind:tap="onAddGroup">+</view>
          </scroll-view>
        </view>
        </view>
        <!-- /吸顶区 -->

        <!-- 账户汇总：每个平台一行，点行切到该平台 -->
        <view wx:if="{{activePlatform === 'summary'}}" class="platform-summary">
          <view class="ps-row ps-row-head">
            <text class="ps-head-title">账户</text>
            <text class="ps-head-hint">点账户查看该账户持仓</text>
          </view>
          <view class="ps-row" wx:for="{{platformRows}}" wx:key="name" bind:tap="onPlatformTap" data-name="{{item.name}}">
            <view class="ps-main">
              <view class="ps-name">{{item.name}}</view>
              <view class="ps-sub">{{item.count}} 只持仓</view>
            </view>
            <view class="ps-nums">
              <view class="ps-amount">{{amountVisible ? fmt.money(item.totalAmount) : '****'}}</view>
              <view class="ps-profit {{item.todayProfit > 0 ? 'up' : item.todayProfit < 0 ? 'down' : ''}}">
                {{amountVisible ? fmt.money(item.todayProfit, true) : '****'}}<text class="ps-rate">{{item.todayProfitRate > 0 ? '+' : ''}}{{item.todayProfitRate}}%</text>
              </view>
            </view>
            <view class="ps-arrow">›</view>
          </view>
          <view wx:if="{{!platformRows.length}}" class="ps-empty">还没有账户：新增持有时选一个账户，或点顶部「+」新建</view>
          <!-- 总览页是分析的天然入口（分析按整个组合算，不按账户切） -->
          <view wx:if="{{holdings.length >= 2}}" class="ps-row" bind:tap="onCorrelation">
            <view class="ps-main">
              <view class="ps-name">📊 资产分析</view>
              <view class="ps-sub">持仓分析 · 费用与复盘</view>
            </view>
            <view class="ps-arrow">›</view>
          </view>
          <view wx:if="{{platformRows.length && platformRows[platformRows.length-1].unassigned}}" class="ps-tip">「未分配」的持仓可以长按列表行 →「设置账户」归入某个账户</view>
        </view>

        <view wx:if="{{displayHoldings.length > 0 && activePlatform !== 'summary'}}" class="holdings-section">
          <scroll-view class="table-scroll" scroll-x show-scrollbar="{{false}}" enable-flex>
            <view class="table-inner">
              <view class="t-row t-head">
                <!-- 名称列（管理入口已挪到标签栏右端） -->
                <view class="t-cell t-name">
                  <view class="t-head-manage" bind:tap="onToggleBatch">
                    <view class="batch-bars">
                      <view class="batch-bar"></view>
                      <view class="batch-bar"></view>
                      <view class="batch-bar"></view>
                    </view>
                  </view>
                </view>
                <view wx:for="{{colOrder}}" wx:key="*this" wx:for-item="col"
                  class="t-cell {{colDefs[col].sortable && sortField === col ? 'active' : ''}} {{colDefs[col].isValuation ? 't-temp-header' : ''}}"
                  bind:tap="{{colDefs[col].sortable ? 'onSortTap' : 'onTempInfoTap'}}"
                  data-field="{{colDefs[col].sortable ? col : ''}}">
                  <text style="flex:1;text-align:right">{{colDefs[col].label}}</text><text wx:if="{{colDefs[col].sortable && sortField === col}}" style="font-size:18rpx">{{sortOrder === 'desc' ? '↓' : '↑'}}</text><text wx:if="{{colDefs[col].isValuation}}" class="t-temp-icon"> ⓘ</text>
                </view>
              </view>
              <view wx:for="{{displayHoldings}}" wx:key="_id" class="t-row {{batchMode && item._checked ? 'selected' : ''}}"
                bind:tap="onTapHolding" bind:longpress="onLongPressHolding"
                data-code="{{item.fundCode}}" data-name="{{item.fundName}}" data-id="{{item._id}}">
                <view class="t-cell t-name">
                  <view wx:if="{{batchMode}}" class="batch-check {{item._checked ? 'checked' : ''}}" catch:tap="onToggleBatchSelect" data-index="{{index}}">{{item._checked ? '✓' : ''}}</view>
                  <view class="name-text">{{item.fundName}}</view>
                  <view class="code-text"><text wx:if="{{item.estimateUpdated}}" class="updated-tag">✓</text>{{item.fundCode}}<text wx:if="{{item._tag}}" class="group-tag">{{item._tag}}</text></view>
                </view>
                <view wx:for="{{colOrder}}" wx:key="*this" wx:for-item="col" class="t-cell">
                  <block wx:if="{{col === 'todayProfit'}}">
                    <view class="t-val {{item._crCls}}">{{item._crText}}</view>
                    <view class="t-sub {{amountVisible ? item._tpCls : ''}}">{{amountVisible ? fmt.money(item.todayProfit, true) : '****'}}</view>
                  </block>
                  <block wx:elif="{{col === 'totalReturn'}}">
                    <view class="t-val {{item._trrCls}}">{{item._trrText}}</view>
                    <view class="t-sub {{amountVisible ? item._trCls : ''}}">{{amountVisible ? fmt.money(item.totalReturn, true) : '****'}}</view>
                  </block>
                  <block wx:elif="{{col === 'ratio'}}">
                    <view class="t-val">{{item._ratioText}}</view>
                    <view class="t-sub">{{amountVisible ? fmt.money(item.marketValue, true) : '****'}}</view>
                  </block>
                  <block wx:elif="{{col === 'drawdown'}}">
                    <view class="t-val">{{item._ddText}}</view>
                    <view class="t-sub">高点 {{item.navHigh || '--'}}</view>
                  </block>
                  <block wx:elif="{{col === 'valuation'}}">
                    <view class="t-val {{item._valCls}}">{{item._valText}}</view>
                    <view wx:if="{{item._peSub}}" class="t-sub">{{item._peSub}}</view>
                  </block>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>

        <view wx:elif="{{activeGroup !== 'all' && activePlatform !== 'summary'}}" class="empty-group">
          <view class="empty-icon">📂</view>
          <view class="empty-desc">该分组暂无持仓</view>
          <view class="empty-hint">长按持仓可移动到本分组</view>
        </view>

        <view wx:if="{{updateTime}}" class="update-time">估算时间：{{updateTime}}<text wx:if="{{stale}}" class="stale-badge" bind:tap="_silentRefresh">更新失败</text></view>
      </view>
    </view>
  </scroll-view>

  <!-- 悬浮操作：新增/加减仓/资产分析（原先占常驻区 84px 的快捷入口，挪到拇指可及处） -->
  <view wx:if="{{!batchMode && !indexExpanded && !showIndexEdit && holdings.length > 0}}" class="fab" bind:tap="onFabTap">
    <text class="fab-icon">＋</text>
  </view>

  <view wx:if="{{indexCards.length > 0}}" class="index-bar">
    <view wx:if="{{showIndexEdit}}" class="index-edit-panel">
      <view class="idx-edit-header">
        <text class="idx-edit-title">选择显示的指数</text>
        <view class="idx-edit-done" bind:tap="onToggleIndexEdit">取消</view>
      </view>
      <view wx:for="{{ALL_INDICES}}" wx:key="code" class="idx-check-item" bind:tap="onToggleIndexItem" data-code="{{item.code}}">
        <view class="idx-checkbox {{editSelections[item.code] ? 'checked' : ''}}">{{editSelections[item.code] ? '✓' : ''}}</view>
        <text class="idx-check-label">{{item.name}}</text>
      </view>
      <view class="idx-edit-actions">
        <view class="idx-save-btn" bind:tap="onSaveIndexPrefs">保存</view>
      </view>
    </view>
    <view wx:elif="{{!indexExpanded}}" class="index-collapsed" bind:tap="onToggleIndex">
      <text class="idx-name">{{indexCards[0].name}}</text>
      <text class="idx-price {{indexCards[0].isUp ? 'up' : 'down'}}">{{indexCards[0].price}}</text>
      <text class="idx-change {{indexCards[0].isUp ? 'up' : 'down'}}">{{indexCards[0].change}}</text>
      <text class="idx-change-rate {{indexCards[0].isUp ? 'up' : 'down'}}">{{indexCards[0].changeRate}}%</text>
      <text class="idx-expand-hint">▼</text>
    </view>
    <view wx:elif="{{indexExpanded}}" class="index-expanded-panel">
      <view class="idx-expanded-top" bind:tap="onToggleIndex">
        <text class="idx-gear" catch:tap="onToggleIndexEdit">⚙</text>
        <text class="idx-collapse-arrow">▲</text>
      </view>
      <scroll-view scroll-x class="index-scroll" enhanced show-scrollbar="{{false}}" catch:tap="noop">
        <view wx:for="{{indexCards}}" wx:key="code" class="index-card {{item.isUp ? 'card-up' : 'card-down'}}" bind:tap="onIndexCardTap" data-code="{{item.code}}">
          <view class="ic-name">{{item.name}}</view>
          <view class="ic-price {{item.isUp ? 'up' : 'down'}}">{{item.price}}</view>
          <view class="ic-change-row">
            <text class="{{item.isUp ? 'up' : 'down'}}">{{item.change}}</text>
            <text class="{{item.isUp ? 'up' : 'down'}}">  {{item.changeRate}}%</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 账户/分组管理面板：点「+」打开，新建/重命名/删除都在这一层，不用长按找 -->
  <view wx:if="{{managePanel}}" class="mp-mask" bind:tap="onCloseManage">
    <view class="mp-card" catch:tap="noop"
      bind:touchstart="onManageTouchStart" bind:touchmove="onManageTouchMove" bind:touchend="onManageTouchEnd">
      <view class="mp-head">{{managePanel.title}}<text class="mp-head-tip">↑↓ 或长按拖动可调顺序</text></view>
      <scroll-view scroll-y="{{!mpDragging}}" class="mp-list">
        <view class="mp-row {{mpDragIndex === index ? 'dragging' : ''}}" wx:for="{{managePanel.items}}" wx:key="name">
          <view class="mp-ord">
            <view class="mp-ord-btn {{index === 0 ? 'off' : ''}}" catch:tap="onManageMove" data-name="{{item.name}}" data-dir="up">↑</view>
            <view class="mp-ord-btn {{index === managePanel.items.length - 1 ? 'off' : ''}}" catch:tap="onManageMove" data-name="{{item.name}}" data-dir="down">↓</view>
          </view>
          <view class="mp-main">
            <view class="mp-name">{{item.name}}</view>
            <view class="mp-sub">{{item.count}} 只持仓</view>
          </view>
          <view class="mp-act" catch:tap="onManageRename" data-name="{{item.name}}">重命名</view>
          <view class="mp-act danger" catch:tap="onManageDelete" data-name="{{item.name}}">删除</view>
        </view>
        <view wx:if="{{!managePanel.items.length}}" class="mp-empty">还没有{{managePanel.noun}}，点下方新建</view>
      </scroll-view>
      <view class="mp-new" catch:tap="onManageCreate">＋ 新建{{managePanel.noun}}</view>
    </view>
  </view>

  <!-- 温度说明浮层（放在最外层，避免 scroll-view 内 fixed 失效） -->
  <view wx:if="{{showTempInfo}}" class="temp-tooltip-mask" bind:tap="onTempInfoTap">
    <view class="temp-tooltip-card" catch:tap="noop">
      <view class="temp-tooltip-arrow"></view>
      <view class="temp-tooltip-formula">
        <view class="temp-tooltip-item">📊 穿透前十大重仓股，基于每只个股历年 PE 历史区间计算当前分位，按持仓占比加权汇总</view>
        <view class="temp-tooltip-item">⚖️ 金融股 PE+PB 双评 · 周期股低位警示 · 亏损股及超高 PE 约束</view>
      </view>
      <view class="temp-tooltip-rule">{{lt}} 0.75 温度偏低 · 0.75～1.25 温度适中 · {{gt}} 1.25 温度偏高</view>
      <view class="temp-tooltip-disclaimer">估算数据仅供参考，不构成投资建议</view>
      <view class="temp-tooltip-update">⏱ 每日凌晨更新</view>
    </view>
  </view>

  <!-- 列表头排序 -->
  <view wx:if="{{showColEdit}}" class="col-edit-mask" bind:tap="onCloseColEdit">
    <view class="col-edit-card" catch:tap="noop">
      <view class="col-edit-title">调整列表头顺序</view>
      <view wx:for="{{colOrder}}" wx:key="*this" class="col-edit-row">
        <text class="col-edit-name">{{colDefs[item].label}}</text>
        <view class="col-edit-btns">
          <text class="col-edit-btn {{index === 0 ? 'disabled' : ''}}" bind:tap="onColMoveUp" data-index="{{index}}">↑</text>
          <text class="col-edit-btn {{index === colOrder.length - 1 ? 'disabled' : ''}}" bind:tap="onColMoveDown" data-index="{{index}}">↓</text>
        </view>
      </view>
      <view class="col-edit-close" bind:tap="onCloseColEdit">完成</view>
    </view>
  </view>

  <!-- 涨跌提醒设置 -->
  <view wx:if="{{showAlertEdit}}" class="col-edit-mask" bind:tap="onCloseAlertEdit">
    <view class="col-edit-card" catch:tap="noop">
      <view class="col-edit-title">涨跌提醒 — {{alertEditFundName}}</view>
      <view class="alert-field"><text class="alert-label">上涨提醒线(%)</text><input class="alert-input" value="{{alertEditUpper}}" bindinput="onAlertUpper" type="digit" placeholder="例如3"/></view>
      <view class="alert-field"><text class="alert-label">下跌提醒线(%)</text><input class="alert-input" value="{{alertEditLower}}" bindinput="onAlertLower" type="digit" placeholder="例如-3"/></view>
      <view class="alert-field alert-switch-row" catch:tap="onAlertPeToggle">
        <text class="alert-label">温度变化提醒</text>
        <view class="pe-switch {{alertEditPeAlert ? 'on' : ''}}">
          <view class="pe-switch-dot"></view>
        </view>
      </view>
      <view class="col-edit-close" bind:tap="onSaveAlert">保存</view>
    </view>
  </view>

  <!-- 移动分组选择器 -->
  <view wx:if="{{showGroupPicker}}" class="col-edit-mask" bind:tap="onCloseGroupPicker">
    <view class="col-edit-card" catch:tap="noop">
      <view class="col-edit-title">{{groupPickerTitle}}</view>
      <!-- 两个维度：基金分组（策略）/ 平台（账户） -->
      <view class="picker-field-row">
        <text class="picker-field-chip {{groupPickerField === 'group' ? 'active' : ''}}" bind:tap="onPickerFieldTap" data-field="group">基金分组</text>
        <text class="picker-field-chip {{groupPickerField === 'platform' ? 'active' : ''}}" bind:tap="onPickerFieldTap" data-field="platform">账户</text>
      </view>
      <scroll-view scroll-y style="max-height:480rpx;margin:12rpx 0 16rpx">
        <view wx:if="{{groupPickerOptions.length === 0}}" class="group-picker-empty">{{groupPickerField === 'platform' ? '暂无账户，点下方新建' : '暂无分组，请先新建'}}</view>
        <view wx:for="{{groupPickerOptions}}" wx:key="*this" class="group-picker-item" bind:tap="onPickGroup" data-group="{{item}}">{{item}}</view>
        <view class="group-picker-item" bind:tap="onPickGroup" data-group="">{{groupPickerField === 'platform' ? '📂 不指定账户' : '📂 未分组'}}</view>
      </scroll-view>
      <view class="group-picker-new-btn" bind:tap="onPickNewGroup">+ 新建{{groupPickerField === 'platform' ? '账户' : '分组'}}</view>
      <view class="col-edit-close" bind:tap="onCloseGroupPicker" style="margin-top:16rpx;background:#F5F5F5;color:#666">取消</view>
    </view>
  </view>

  <!-- 分享卡片预览 -->
  <view wx:if="{{showShareCard}}" class="share-card-mask" bind:tap="onCloseShareCard">
    <view class="share-card-panel" catch:tap="noop">
      <view class="share-card-header">
        <text class="share-card-title">持仓分享卡片</text>
        <text class="share-card-close" bind:tap="onCloseShareCard">✕</text>
      </view>
      <view class="share-variant-chips" wx:if="{{eventDay}}">
        <text class="svc-chip {{cardVariant === 'profit' ? 'active' : ''}}" data-variant="profit" bind:tap="onCardVariant">收益卡</text>
        <text class="svc-chip {{cardVariant === 'temp' ? 'active' : ''}}" data-variant="temp" bind:tap="onCardVariant">温度卡</text>
      </view>
      <canvas type="2d" id="shareCanvas" class="share-canvas" style="width:600rpx;height:880rpx"></canvas>
      <view class="share-card-actions">
        <button class="share-save-btn" bind:tap="onSaveShareCard">保存到相册</button>
        <button class="share-send-btn" bind:tap="onShareToFriend">分享给好友</button>
      </view>
    </view>
  </view>

  <!-- 新手导览（首笔持仓后一次性） -->
  <view wx:if="{{showGuide}}" class="guide-mask">
    <view class="guide-panel" catch:tap="noop">
      <swiper class="guide-swiper" current="{{guideIdx}}" bindchange="onGuideChange">
        <swiper-item wx:for="{{guidePages}}" wx:key="title">
          <view class="guide-page">
            <view class="guide-icon">{{item.icon}}</view>
            <view class="guide-title">{{item.title}}</view>
            <view class="guide-desc">{{item.desc}}</view>
          </view>
        </swiper-item>
      </swiper>
      <view class="guide-dots">
        <view class="guide-dot {{guideIdx === index ? 'active' : ''}}" wx:for="{{guidePages}}" wx:key="title" data-i="{{index}}" bind:tap="onGuideDot"></view>
      </view>
      <button class="guide-btn" bind:tap="onGuideNext">{{guideIdx === guidePages.length - 1 ? '开始使用' : '下一页'}}</button>
    </view>
  </view>

  <!-- 新版本功能提示 -->
  <view wx:if="{{showUpdateLog}}" class="ver-mask">
    <view class="ver-card">
      <view class="ver-title">韭菜估值宝</view>
      <view class="ver-version">版本 {{updateVersion}} 更新</view>
      <view class="ver-body">
        <block wx:for="{{updateItems}}" wx:key="*this">
          <view class="ver-item">• {{item}}</view>
        </block>
      </view>
      <view class="ver-close" bind:tap="onCloseUpdateLog">知道了</view>
    </view>
  </view>

  <!-- 添加到我的小程序轻引导（指向右上角胶囊） -->
  <view wx:if="{{showAddGuide}}" class="add-guide" bind:tap="onCloseAddGuide">
    <text class="add-guide-text">点右上角「···」→ 添加到我的小程序</text>
    <view class="add-guide-close">×</view>
  </view>
</view>
