<view class="page {{theme === 'red' ? 'theme-red' : 'theme-blue'}}">
  <view class="disclaimer">数据来源：公开市场数据，仅供参考，不构成投资建议。</view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="mk-loading"><text class="mk-loading-text">加载中...</text></view>

  <!-- 加载失败 -->
  <view wx:elif="{{loadError}}" class="mk-loading">
    <text class="mk-loading-text">行情加载失败，下拉重试</text>
  </view>

  <block wx:else>
    <!-- 持仓港美股敞口（登录且有持仓时展示，纯数据陈述）+ 重仓股实时行情 -->
    <view wx:if="{{exposure && exposure.hasData}}" class="mk-card">
      <view class="mk-sec-title">你的持仓港美股敞口</view>
      <view class="exp-row">
        <view class="exp-item">
          <view class="exp-pct up-text">{{exposure.hkPct == null ? '--' : exposure.hkPct}}%</view>
          <view class="exp-label">重仓港股<text class="exp-cnt" wx:if="{{exposure.hkCount}}">（{{exposure.hkCount}} 只基金）</text></view>
        </view>
        <view class="exp-item">
          <view class="exp-pct">{{exposure.usPct == null ? '--' : exposure.usPct}}%</view>
          <view class="exp-label">重仓美股<text class="exp-cnt" wx:if="{{exposure.usCount}}">（{{exposure.usCount}} 只基金）</text></view>
        </view>
      </view>
      <view class="exp-tip">按持仓基金最新公布的重仓股占比与市值加权估算</view>
    </view>

    <!-- 重仓股实时行情（你的基金底仓视角，他处不可见） -->
    <view wx:if="{{exposure && (exposure.hkStocks.length || exposure.usStocks.length)}}" class="mk-card">
      <view wx:if="{{exposure.hkStocks.length}}" class="stock-sec">
        <view class="stock-sec-title">重仓港股<text class="stock-sec-note">按占仓权重排序 · 点击看详情</text></view>
        <view class="stock-row" wx:for="{{exposure.hkStocks}}" wx:key="code" data-code="{{item.code}}" data-market="hk" bind:tap="onStockTap">
          <view class="stock-name">
            <view class="stock-name-text">{{item.name}}</view>
            <view class="stock-code">{{item.code}} · 占仓 {{item.weight}}%</view>
          </view>
          <view class="stock-quote">
            <view class="stock-price">{{item.price != null ? item.price : '--'}}</view>
            <view class="stock-rate {{item.changeRate > 0 ? 'up' : item.changeRate < 0 ? 'down' : 'dim'}}">{{item.changeRate != null ? (item.changeRate > 0 ? '+' : '') + item.changeRate + '%' : '--'}}</view>
          </view>
        </view>
      </view>
      <view wx:if="{{exposure.usStocks.length}}" class="stock-sec">
        <view class="stock-sec-title">重仓美股<text class="stock-sec-note">按占仓权重排序 · 点击看详情</text></view>
        <view class="stock-row" wx:for="{{exposure.usStocks}}" wx:key="code" data-code="{{item.code}}" data-market="us" bind:tap="onStockTap">
          <view class="stock-name">
            <view class="stock-name-text">{{item.name}}</view>
            <view class="stock-code">{{item.code}} · 占仓 {{item.weight}}%</view>
          </view>
          <view class="stock-quote">
            <view class="stock-price">{{item.price != null ? item.price : '--'}}</view>
            <view class="stock-rate {{item.changeRate > 0 ? 'up' : item.changeRate < 0 ? 'down' : 'dim'}}">{{item.changeRate != null ? (item.changeRate > 0 ? '+' : '') + item.changeRate + '%' : '--'}}</view>
          </view>
        </view>
      </view>
      <view class="exp-tip">行情为腾讯实时报价（可能有 15 分钟延迟，以交易所为准）</view>
    </view>

    <!-- 核心指数 -->
    <view class="mk-card">
      <view class="mk-sec-title-row">
        <view class="mk-sec-title">核心指数</view>
        <text class="mk-sec-note">港股{{hkStatus}} · 美股{{usStatus}} · 亚太{{apStatus}}</text>
      </view>
      <view class="idx-tabs">
        <view class="idx-tab {{idxTab === item.key ? 'active' : ''}}" wx:for="{{idxTabs}}" wx:key="key" data-key="{{item.key}}" bind:tap="onIdxTab">{{item.label}}</view>
      </view>
      <scroll-view scroll-x class="idx-scroll" enable-flex>
        <view class="idx-card" wx:for="{{indexCards}}" wx:key="code" data-code="{{item.code}}" data-name="{{item.name}}" bind:tap="onIdxCardTap">
          <view class="idx-name">{{item.name}}</view>
          <view class="idx-price {{item.isUp ? 'up' : 'down'}}">{{item.price}}</view>
          <view class="idx-rate {{item.isUp ? 'up' : 'down'}}">{{item.rateText}}</view>
          <view class="idx-more">近5日走势 ›</view>
        </view>
      </scroll-view>
      <view class="mk-updated" wx:if="{{updatedAt}}">数据更新于 {{updatedAt}}</view>
    </view>

    <!-- 指数走势弹层（近5日/近1月/近3月可切） -->
    <view wx:if="{{showIdxModal}}" class="idx-modal-mask" bind:tap="onIdxModalClose">
      <view class="idx-modal" catch:tap="noop">
        <view class="idx-modal-head">
          <text class="idx-modal-title">{{idxModalName}} · 走势</text>
          <view class="idx-modal-close" bind:tap="onIdxModalClose">×</view>
        </view>
        <view class="idx-period-chips">
          <text wx:if="{{idxModalIntradayOk}}" class="idx-period-chip {{idxPeriod === 'intraday' ? 'active' : ''}}" data-days="intraday" bind:tap="onIdxPeriod">分时</text>
          <text class="idx-period-chip {{idxPeriod === 5 ? 'active' : ''}}" data-days="5" bind:tap="onIdxPeriod">近5日</text>
          <text class="idx-period-chip {{idxPeriod === 22 ? 'active' : ''}}" data-days="22" bind:tap="onIdxPeriod">近1月</text>
          <text class="idx-period-chip {{idxPeriod === 66 ? 'active' : ''}}" data-days="66" bind:tap="onIdxPeriod">近3月</text>
        </view>
        <view wx:if="{{idxModalLoading}}" class="mk-loading"><text class="mk-loading-text">加载中...</text></view>
        <view wx:elif="{{idxModalError}}" class="mk-loading"><text class="mk-loading-text">走势加载失败，请重试</text></view>
        <canvas wx:else type="2d" id="idxModalCanvas" class="idx-modal-canvas"></canvas>
        <view class="idx-modal-foot">数据来源：公开市场数据，仅供参考</view>
      </view>
    </view>

    <!-- 重仓股详情弹层：报价 + 估值信息 + 港股附5日走势 -->
    <view wx:if="{{showStockModal}}" class="idx-modal-mask" bind:tap="onStockModalClose">
      <view class="idx-modal" catch:tap="noop">
        <view class="idx-modal-head">
          <text class="idx-modal-title">{{stockModal.name}}（{{stockModal.code}}）</text>
          <view class="idx-modal-close" bind:tap="onStockModalClose">×</view>
        </view>
        <view class="sm-quote-row">
          <view class="sm-price {{stockModal.changeRate > 0 ? 'up' : stockModal.changeRate < 0 ? 'down' : ''}}">{{stockModal.price != null ? stockModal.price : '--'}}</view>
          <view class="sm-rate {{stockModal.changeRate > 0 ? 'up' : stockModal.changeRate < 0 ? 'down' : 'dim'}}">{{stockModal.changeRate != null ? (stockModal.changeRate > 0 ? '+' : '') + stockModal.changeRate + '%' : '--'}}</view>
          <view class="sm-weight">占你的组合 {{stockModal.weight}}%</view>
        </view>
        <view class="sm-meta">
          <view class="sm-meta-item"><text class="sm-meta-label">市盈率PE</text><text class="sm-meta-val">{{stockModal.pe != null ? stockModal.pe : '--'}}</text></view>
          <view class="sm-meta-item"><text class="sm-meta-label">市净率PB</text><text class="sm-meta-val">{{stockModal.pb != null ? stockModal.pb : '--'}}</text></view>
          <view class="sm-meta-item"><text class="sm-meta-label">行业</text><text class="sm-meta-val">{{stockModal.industry || '--'}}</text></view>
        </view>
        <view wx:if="{{stockModal.fundsText}}" class="sm-funds">持有该股的基金：{{stockModal.fundsText}}</view>
        <block wx:if="{{stockKlineLoading}}"><view class="mk-loading"><text class="mk-loading-text">加载走势...</text></view></block>
        <block wx:elif="{{stockKlineOk}}"><canvas type="2d" id="stockModalCanvas" class="idx-modal-canvas"></canvas></block>
        <view class="idx-modal-foot">数据来源：公开市场数据（可能有延迟），仅供参考</view>
      </view>
    </view>

    <!-- 空数据 -->
    <view wx:if="{{emptyData}}" class="mk-loading"><text class="mk-loading-text">行情数据暂不可用，请稍后再试</text></view>
  </block>
</view>
