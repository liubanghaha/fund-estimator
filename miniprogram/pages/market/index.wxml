<view class="page {{theme === 'red' ? 'theme-red' : 'theme-blue'}}">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="mk-loading"><text class="mk-loading-text">加载中...</text></view>

  <!-- 加载失败 -->
  <view wx:elif="{{loadError}}" class="mk-loading">
    <text class="mk-loading-text">行情加载失败，下拉重试</text>
  </view>

  <block wx:else>
    <!-- 你的持仓行业（置顶模块，未登录/无匹配时不展示） -->
    <view wx:if="{{minePages.length}}" class="mk-card">
      <view class="mk-sec-title">你的持仓行业今日表现<text class="mk-sec-note">数据陈述，仅供参考</text></view>
      <swiper class="sec-swiper" indicator-dots="{{minePages.length > 1}}" indicator-color="rgba(0,0,0,.12)" indicator-active-color="var(--primary,#E4393C)">
        <swiper-item wx:for="{{minePages}}" wx:key="index" wx:for-item="page">
          <view class="sec-grid">
            <view class="sec-card {{item.isUp ? 'up-bg' : item.isDown ? 'down-bg' : ''}} mine" wx:for="{{page}}" wx:key="code">
              <view class="sec-name">{{item.name}}</view>
              <view class="sec-rate {{item.isUp ? 'up' : item.isDown ? 'down' : ''}}">{{item.rateText}}</view>
              <view class="sec-sub">{{item.weightText}}</view>
            </view>
          </view>
        </swiper-item>
      </swiper>
    </view>

    <!-- 市场概览：两市成交额 + 涨跌家数（数据陈述） -->
    <view class="mk-card">
      <view class="mk-sec-title">市场概览</view>
      <view class="ov-amount-row">
        <view class="ov-amount">
          <view class="ov-amount-num">{{amountText}}</view>
          <view class="ov-amount-label">两市成交额</view>
        </view>
        <view class="ov-split">
          <view class="ov-split-item"><text class="ov-split-label">沪市</text><text class="ov-split-val">{{shAmountText}}</text></view>
          <view class="ov-split-item"><text class="ov-split-label">深市</text><text class="ov-split-val">{{szAmountText}}</text></view>
        </view>
      </view>
      <view class="ov-breadth">
        <view class="ov-breadth-nums">
          <text class="up">上涨 {{overview.up || 0}}</text>
          <text class="dim">平 {{overview.flat || 0}}</text>
          <text class="down">下跌 {{overview.down || 0}}</text>
        </view>
        <view class="ov-bar">
          <view class="ov-bar-up" style="width:{{upPct}}%"></view>
          <view class="ov-bar-down" style="width:{{downPct}}%"></view>
        </view>
      </view>
    </view>

    <!-- 行业板块 -->
    <view wx:if="{{marketPages.length}}" class="mk-card">
      <view class="mk-sec-title">行业板块表现<text class="mk-sec-note">数据陈述，仅供参考</text></view>
      <swiper class="sec-swiper" indicator-dots="{{marketPages.length > 1}}" indicator-color="rgba(0,0,0,.12)" indicator-active-color="var(--primary,#E4393C)">
        <swiper-item wx:for="{{marketPages}}" wx:key="index" wx:for-item="page">
          <view class="sec-grid">
            <view class="sec-card {{item.isUp ? 'up-bg' : item.isDown ? 'down-bg' : ''}}" wx:for="{{page}}" wx:key="code">
              <view class="sec-name">{{item.name}}</view>
              <view class="sec-rate {{item.isUp ? 'up' : item.isDown ? 'down' : ''}}">{{item.rateText}}</view>
              <view wx:if="{{item.leaderText}}" class="sec-sub">{{item.leaderText}}</view>
            </view>
          </view>
        </swiper-item>
      </swiper>
    </view>

    <!-- 核心指数 -->
    <view class="mk-card">
      <view class="idx-tabs">
        <view class="idx-tab {{idxTab === item.key ? 'active' : ''}}" wx:for="{{idxTabs}}" wx:key="key" data-key="{{item.key}}" bind:tap="onIdxTab">{{item.label}}</view>
      </view>
      <scroll-view scroll-x class="idx-scroll" enable-flex>
        <view class="idx-card" wx:for="{{indexCards}}" wx:key="code">
          <view class="idx-name">{{item.name}}</view>
          <view class="idx-price {{item.isUp ? 'up' : 'down'}}">{{item.price}}</view>
          <view class="idx-rate {{item.isUp ? 'up' : 'down'}}">{{item.rateText}}</view>
          <view wx:if="{{item.flowText}}" class="idx-flow {{item.isFlowUp ? 'up' : 'down'}}">{{item.flowText}}</view>
        </view>
      </scroll-view>
      <view class="mk-updated" wx:if="{{updatedAt}}">数据更新于 {{updatedAt}}</view>
    </view>

    <!-- 空数据 -->
    <view wx:if="{{emptyData}}" class="mk-loading"><text class="mk-loading-text">行情数据暂不可用，请稍后再试</text></view>
  </block>
</view>
