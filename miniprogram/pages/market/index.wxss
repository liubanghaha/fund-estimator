/* 行情中心 V1·合规整改版：港美股敞口 + 港/美/亚指数 */
.page{min-height:100vh;background:#F5F5F5;padding:16rpx 24rpx 40rpx;box-sizing:border-box}
.disclaimer{font-size:20rpx;color:#BBB;text-align:center;padding:8rpx 0 4rpx}
.mk-card{background:#FFF;border-radius:var(--radius-card);padding:28rpx 24rpx;margin-bottom:20rpx;box-shadow:var(--shadow-card);}
.mk-sec-title{font-size:28rpx;font-weight:700;color:#333;margin-bottom:20rpx}
.mk-loading{padding:120rpx 0;text-align:center}
.mk-loading-text{font-size:26rpx;color:#BBB}
.mk-updated{font-size:20rpx;color:#CCC;text-align:center;padding-top:16rpx}

/* 涨跌色（红涨绿跌，与全站一致） */
.up{color:var(--up)}
.down{color:#2E8B57}

/* ===== 持仓港美股敞口 ===== */
.exp-row{display:flex;gap:24rpx;margin-bottom:16rpx}
.exp-item{flex:1;background:#F8F8F8;border-radius:14rpx;padding:20rpx}
.exp-pct{font-size:40rpx;font-weight:700;color:#333}
.exp-pct.up-text{color:var(--primary,var(--up))}
.exp-label{font-size:22rpx;color:#999;margin-top:6rpx}
.exp-cnt{font-size:20rpx;color:#BBB}
.exp-note{font-size:24rpx;color:#666;line-height:1.6;margin-bottom:8rpx}
.exp-tip{font-size:20rpx;color:#BBB}

/* ===== 核心指数横滑 ===== */
.idx-scroll{white-space:nowrap}
.idx-card{display:inline-block;vertical-align:top;min-width:200rpx;margin-right:16rpx;border-radius:14rpx;padding:20rpx;box-sizing:border-box;background:#F8F8F8}
.idx-name{font-size:24rpx;color:#666}
.idx-price{font-size:34rpx;font-weight:700;margin-top:8rpx}
.idx-rate{font-size:24rpx;margin-top:4rpx}

/* 指数分类切换（港/美/亚太） */
.idx-tabs{display:flex;gap:14rpx;margin-bottom:18rpx}
.idx-tab{font-size:24rpx;color:#666;background:#F2F2F2;border-radius:26rpx;padding:8rpx 26rpx}
.idx-tab.active{color:#FFF;background:var(--primary,var(--up));font-weight:600}

/* ===== 重仓股实时榜 ===== */
.stock-sec{margin-bottom:20rpx}
.stock-sec:last-of-type{margin-bottom:8rpx}
.stock-sec-title{font-size:26rpx;font-weight:600;color:#444;margin-bottom:12rpx}
.stock-sec-note{font-size:20rpx;color:#BBB;font-weight:400;margin-left:12rpx}
.stock-row{display:flex;align-items:center;justify-content:space-between;padding:14rpx 0;border-bottom:1rpx solid #F5F5F5}
.stock-row:last-child{border-bottom:none}
.stock-name{flex:1;min-width:0}
.stock-name-text{font-size:26rpx;color:#333;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.stock-code{font-size:20rpx;color:#BBB;margin-top:2rpx}
.stock-quote{display:flex;align-items:center;gap:20rpx}
.stock-price{font-size:26rpx;color:#333;font-weight:600;min-width:110rpx;text-align:right}
.stock-rate{font-size:24rpx;min-width:90rpx;text-align:right}

/* ===== 指数 5 日走势弹层 ===== */
.idx-modal-mask{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;display:flex;align-items:center;justify-content:center}
.idx-modal{width:640rpx;background:#FFF;border-radius:20rpx;padding:28rpx 24rpx 16rpx}
.idx-modal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx}
.idx-modal-title{font-size:30rpx;font-weight:700;color:#333}
.idx-modal-close{font-size:40rpx;color:#CCC;padding:0 8rpx;line-height:1}
.idx-modal-canvas{width:100%;height:320rpx}
.idx-modal-foot{font-size:20rpx;color:#CCC;text-align:center;padding-top:12rpx}

/* ===== 走势周期切换 ===== */
.idx-period-chips{display:flex;gap:10rpx;margin-bottom:14rpx}
.idx-period-chip{font-size:22rpx;color:#888;background:#F2F2F2;border-radius:20rpx;padding:6rpx 20rpx}
.idx-period-chip.active{color:#FFF;background:var(--primary,var(--up));font-weight:600}

/* ===== 个股弹层 ===== */
.sm-quote-row{display:flex;align-items:baseline;gap:16rpx;margin-bottom:16rpx}
.sm-price{font-size:48rpx;font-weight:700;color:#333}
.sm-rate{font-size:26rpx;font-weight:600}
.sm-weight{font-size:22rpx;color:#999;margin-left:auto}
.sm-meta{display:flex;gap:16rpx;margin-bottom:14rpx}
.sm-meta-item{flex:1;background:#F8F8F8;border-radius:12rpx;padding:14rpx;display:flex;flex-direction:column;align-items:center}
.sm-meta-label{font-size:20rpx;color:#BBB}
.sm-meta-val{font-size:26rpx;color:#333;font-weight:600;margin-top:4rpx;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sm-funds{font-size:22rpx;color:#888;margin-bottom:10rpx;line-height:1.6}

/* 补充：标题行 / 灰字 / 卡片引导（此前引用未定义） */
.mk-sec-title-row{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:20rpx}
.mk-sec-title-row .mk-sec-title{margin-bottom:0}
.mk-sec-note{font-size:20rpx;color:#BBB;font-weight:400}
.dim{color:#BBB}
.idx-more{font-size:20rpx;color:#BBB;margin-top:8rpx}

/* ===== 海外市场速览（指数期货 / 商品 · 汇率） ===== */
.snap-sub{font-size:20rpx;color:#999;margin:6rpx 0 10rpx}
.snap-sub:not(:first-of-type){margin-top:22rpx;padding-top:18rpx;border-top:1rpx solid #F5F5F5}
.snap-row{display:flex;align-items:baseline;padding:10rpx 0}
.snap-name{flex:1;min-width:0;font-size:26rpx;color:#333}
.snap-price{font-size:26rpx;font-weight:600;margin-right:20rpx;text-align:right}
.snap-rate{font-size:24rpx;min-width:110rpx;text-align:right}
.snap-grid{display:flex;flex-wrap:wrap;gap:12rpx}
.snap-tile{width:calc(50% - 6rpx);box-sizing:border-box;background:#F8F8F8;border-radius:12rpx;padding:14rpx 18rpx}
.snap-tile-name{font-size:20rpx;color:#999}
.snap-tile-line{display:flex;align-items:baseline;justify-content:space-between;margin-top:6rpx}
.snap-tile-price{font-size:26rpx;font-weight:600;color:#333}
.snap-tile-rate{font-size:22rpx}
/* 重仓美股的盘前/盘后标记（只有盘外交易时段才出现） */
.stock-session{font-size:18rpx;color:#FFF;background:var(--primary);border-radius:6rpx;padding:2rpx 8rpx;margin-left:10rpx}
