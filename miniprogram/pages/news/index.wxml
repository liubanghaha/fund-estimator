<view class="page {{theme === 'red' ? 'theme-red' : 'theme-blue'}}">
  <view class="disclaimer">资讯来自第三方公开渠道，仅供参考，不构成投资建议。</view>

  <!-- 快讯 7×24 -->
  <view class="filter-row">
      <text class="date-label">{{dateLabel}}</text>
      <text class="filter-chip imp {{importantOnly ? 'active' : ''}}" bind:tap="onImportantToggle">重要</text>
    </view>

    <view class="news-list">
      <view wx:if="{{item.showDay}}" class="news-day">{{item.dayLabel}}</view>
      <view class="news-item" wx:for="{{displayItems}}" wx:key="id">
        <view class="news-left">
          <view class="news-time">{{item.timeShort}}</view>
          <view wx:if="{{item.long}}" class="news-toggle {{item._open ? 'open' : ''}}" data-index="{{index}}" bind:tap="onToggleText">▾</view>
        </view>
        <view class="news-body {{item.important ? 'important' : ''}}">
          <view class="news-text {{item.long && !item._open ? 'clamp' : ''}}" data-index="{{index}}" bind:tap="onToggleText">
            <text wx:if="{{item.important}}" class="news-important-tag">重要</text>
            {{item.content}}
          </view>
          <view class="news-meta">
            <text class="news-source">{{item.sourceText}}</text>
            <text class="news-cat">{{item.categoryText}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{loadingMore}}" class="news-tip">加载中...</view>
      <view wx:if="{{!loading && !loadError && displayItems.length === 0}}" class="news-tip">当前筛选条件下暂无快讯</view>
      <view wx:if="{{hasMore && displayItems.length}}" class="news-tip news-more-btn" bind:tap="loadMore">加载更多</view>
      <view wx:if="{{!hasMore && displayItems.length}}" class="news-tip">已加载全部</view>
    </view>

  <!-- 加载/错误 -->
  <view wx:if="{{loading}}" class="news-loading"><text class="news-tip">分析中...</text></view>
  <view wx:if="{{loadError}}" class="news-loading">
    <text class="news-tip">资讯加载失败，下拉重试</text>
    <button class="news-retry" bind:tap="onRetry">点击重试</button>
  </view>
</view>
