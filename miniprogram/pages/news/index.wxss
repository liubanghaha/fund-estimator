.page{min-height:100vh;background:#F5F5F5;padding:16rpx 24rpx 40rpx;box-sizing:border-box}
.disclaimer{font-size:20rpx;color:#BBB;text-align:center;padding:8rpx 0 4rpx}
.filter-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx}
.filter-chips{display:flex;gap:10rpx}
.filter-chip{font-size:22rpx;color:#666;background:#FFF;border-radius:24rpx;padding:8rpx 22rpx}
.filter-chip.active{color:#FFF;background:var(--primary,var(--up));font-weight:600}
.filter-chip.imp{color:#B8860B;background:#FFF8E1}
.filter-chip.imp.active{color:#FFF;background:#E6A23C}
.news-list{background:#FFF;border-radius:var(--radius-card);padding:8rpx 24rpx;box-shadow:var(--shadow-card);}
.news-day{font-size:22rpx;color:#999;font-weight:600;padding:20rpx 0 4rpx}
.news-item{display:flex;padding:22rpx 0;border-bottom:1rpx solid #F2F2F2}
.news-item:last-child{border-bottom:none}
.news-left{width:90rpx;flex-shrink:0;display:flex;flex-direction:column;align-items:flex-start;gap:12rpx}
.news-time{font-size:22rpx;color:#BBB;padding-top:4rpx}
.news-body{flex:1;min-width:0}
.news-text{font-size:27rpx;color:#333;line-height:1.6}
.news-body.important .news-text{font-weight:600}
.news-important-tag{display:inline-block;font-size:18rpx;color:#FFF;background:var(--up);border-radius:6rpx;padding:2rpx 10rpx;margin-right:10rpx;vertical-align:2rpx}
.news-text.clamp{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:4;overflow:hidden}
.news-toggle{font-size:36rpx;color:#BBB;line-height:1;transition:transform .2s;transform:rotate(0)}
.news-toggle.open{transform:rotate(180deg)}
.date-label{font-size:24rpx;color:#666;font-weight:600}
.news-meta{display:flex;gap:16rpx;margin-top:10rpx;font-size:20rpx;color:#BBB}
.news-tip{font-size:24rpx;color:#BBB;text-align:center;padding:24rpx 0}
.news-loading{padding:40rpx 0}
.news-retry{margin:20rpx auto 0;width:280rpx;font-size:26rpx;background:var(--primary,var(--up));color:#FFF;border-radius:40rpx}
