.page{min-height:100vh;background:#F6F6F6;padding:16rpx 24rpx 40rpx;box-sizing:border-box}
.disclaimer{font-size:20rpx;color:#BBB;text-align:center;padding:8rpx 0 4rpx}
.sub-tabs{display:flex;gap:14rpx;padding:8rpx 0 16rpx}
.sub-tab{font-size:26rpx;color:#666;background:#FFF;border-radius:30rpx;padding:10rpx 30rpx}
.sub-tab.active{color:#FFF;background:var(--primary,#E4393C);font-weight:600}
.filter-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx}
.filter-chips{display:flex;gap:10rpx}
.filter-chip{font-size:22rpx;color:#666;background:#FFF;border-radius:24rpx;padding:8rpx 22rpx}
.filter-chip.active{color:#FFF;background:var(--primary,#E4393C);font-weight:600}
.filter-chip.imp{color:#B8860B;background:#FFF8E1}
.filter-chip.imp.active{color:#FFF;background:#E6A23C}
.news-list{background:#FFF;border-radius:20rpx;padding:8rpx 24rpx}
.news-item{display:flex;padding:22rpx 0;border-bottom:1rpx solid #F2F2F2}
.news-item:last-child{border-bottom:none}
.news-time{width:90rpx;font-size:22rpx;color:#BBB;flex-shrink:0;padding-top:4rpx}
.news-body{flex:1;min-width:0}
.news-text{font-size:27rpx;color:#333;line-height:1.6}
.news-body.important .news-text{font-weight:600}
.news-important-tag{display:inline-block;font-size:18rpx;color:#FFF;background:#E4393C;border-radius:6rpx;padding:2rpx 10rpx;margin-right:10rpx;vertical-align:2rpx}
.news-meta{display:flex;gap:16rpx;margin-top:10rpx;font-size:20rpx;color:#BBB}
.hl-item{padding:24rpx 0;border-bottom:1rpx solid #F2F2F2}
.hl-item:last-child{border-bottom:none}
.hl-title{font-size:29rpx;font-weight:600;color:#333;line-height:1.5}
.hl-summary{font-size:24rpx;color:#888;line-height:1.6;margin-top:10rpx;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}
.hl-meta{font-size:20rpx;color:#BBB;margin-top:10rpx}
.news-tip{font-size:24rpx;color:#BBB;text-align:center;padding:24rpx 0}
.news-loading{padding:40rpx 0}
.news-retry{margin:20rpx auto 0;width:280rpx;font-size:26rpx;background:var(--primary,#E4393C);color:#FFF;border-radius:40rpx}
