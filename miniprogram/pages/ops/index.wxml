<view class="container {{theme === 'red' ? 'theme-red' : 'theme-blue'}}">
  <!-- 权限校验中 -->
  <view wx:if="{{checking}}" class="ops-empty">
    <view class="ops-empty-icon">⏳</view>
    <view class="ops-empty-desc">校验权限中...</view>
  </view>

  <!-- 无权限 -->
  <view wx:elif="{{!isAdmin}}" class="ops-empty">
    <view class="ops-empty-icon">🔒</view>
    <view class="ops-empty-desc">该功能仅运营管理员可见</view>
  </view>

  <block wx:else>
    <!-- Tab 切换 -->
    <view class="ops-tabs">
      <view class="ops-tab {{tab === 'briefing' ? 'active' : ''}}" bind:tap="onTab" data-tab="briefing">温度简报</view>
      <view class="ops-tab {{tab === 'channels' ? 'active' : ''}}" bind:tap="onTab" data-tab="channels">渠道小程序码</view>
      <view class="ops-tab {{tab === 'track' ? 'active' : ''}}" bind:tap="onTab" data-tab="track">埋点周报</view>
      <view class="ops-tab {{tab === 'push' ? 'active' : ''}}" bind:tap="onTab" data-tab="push">推送灰度</view>
    </view>

    <!-- ===== 温度简报 ===== -->
    <view wx:if="{{tab === 'briefing'}}" class="ops-card">
      <view class="ops-card-title">📊 今日温度简报</view>
      <view class="ops-card-desc">基于当日基金估值温度数据生成，可直接复制发朋友圈 / 微信群引流。</view>
      <button class="ops-primary-btn" bind:tap="onGenBriefing" loading="{{briefingLoading}}" disabled="{{briefingLoading}}">生成今日温度简报</button>

      <block wx:if="{{briefing}}">
        <view wx:if="{{briefing.empty}}" class="ops-tip">{{briefing.msg}}</view>
        <block wx:else>
          <view class="ops-stats">
            <view class="ops-stat"><view class="ops-stat-num low">{{briefing.dist.low || 0}}</view><view class="ops-stat-label">温度偏低</view></view>
            <view class="ops-stat"><view class="ops-stat-num mid">{{briefing.dist.mid || 0}}</view><view class="ops-stat-label">温度适中</view></view>
            <view class="ops-stat"><view class="ops-stat-num high">{{briefing.dist.high || 0}}</view><view class="ops-stat-label">温度偏高</view></view>
          </view>
          <view class="ops-briefing-text">{{briefing.copy}}</view>
          <button class="ops-primary-btn" bind:tap="onCopyBriefing">复制文案</button>
        </block>
      </block>
    </view>

    <!-- ===== 渠道小程序码 ===== -->
    <view wx:if="{{tab === 'channels'}}" class="ops-card">
      <view class="ops-card-title">🏷️ 渠道小程序码</view>
      <view class="ops-card-desc">每个渠道一个码，扫码进入自动统计来源。两周后看哪个渠道带来的人最多。</view>

      <view class="ops-add-row">
        <input class="ops-input" value="{{channelName}}" placeholder="渠道名称，如：朋友圈 / 基金群 / 小红书" bindinput="onChannelInput" maxlength="20" />
        <button class="ops-add-btn" bind:tap="onAddChannel" loading="{{addingChannel}}" disabled="{{addingChannel}}">添加</button>
      </view>

      <view wx:if="{{channels.length === 0}}" class="ops-tip">还没有渠道，先添加一个吧</view>

      <view class="ops-channel" wx:for="{{channels}}" wx:key="channelId">
        <view class="ops-channel-head">
          <text class="ops-channel-name">{{item.name}}</text>
          <text class="ops-channel-count">访问 {{item.visitCount}}</text>
        </view>
        <image wx:if="{{codeUrl_[item.channelId]}}" class="ops-code-img" src="{{codeUrl_[item.channelId]}}" mode="aspectFit" />
        <view class="ops-channel-actions">
          <button class="ops-mini-btn primary" bind:tap="onGenerateCode" data-channel-id="{{item.channelId}}" loading="{{generatingCode === item.channelId}}" disabled="{{generatingCode === item.channelId}}">
            {{item.fileID ? '重新生成' : '生成小程序码'}}
          </button>
          <button class="ops-mini-btn danger" bind:tap="onRemoveChannel" data-channel-id="{{item.channelId}}">删除</button>
        </view>
        <view class="ops-channel-tip">scene: c_{{item.channelId}}</view>
      </view>
    </view>

    <!-- ===== 埋点周报 ===== -->
    <view wx:if="{{tab === 'track'}}" class="ops-card">
      <view class="ops-card-title">📈 埋点周报</view>
      <view class="ops-card-desc">启动时段占比 + 各事件计数。核心假设：非交易时段打开占比 3 个月 ≥15%。</view>
      <view class="ops-add-row">
        <picker mode="selector" range="{{[7, 14, 30, 90]}}" value="{{trackDaysIdx}}" bindchange="onTrackDaysChange">
          <button class="ops-mini-btn primary">近 {{trackDays}} 天 ▾</button>
        </picker>
        <button class="ops-add-btn" bind:tap="onGenTrackReport" loading="{{trackLoading}}" disabled="{{trackLoading}}">生成报表</button>
      </view>

      <block wx:if="{{trackReport}}">
        <!-- 启动时段占比 -->
        <view class="ops-channel-head" style="margin-top:24rpx">
          <text class="ops-channel-name">🚀 启动时段占比（analytics_launches）</text>
        </view>
        <view class="ops-stats">
          <view class="ops-stat"><view class="ops-stat-num mid">{{trackReport.launch.tradingPct == null ? '--' : trackReport.launch.tradingPct + '%'}}</view><view class="ops-stat-label">盘中 ({{trackReport.launch.trading}})</view></view>
          <view class="ops-stat"><view class="ops-stat-num high">{{trackReport.launch.afterClosePct}}</view><view class="ops-stat-label">盘后 ({{trackReport.launch.afterClose}})</view></view>
          <view class="ops-stat"><view class="ops-stat-num low">{{trackReport.launch.closedPct}}</view><view class="ops-stat-label">休市 ({{trackReport.launch.closed}})</view></view>
        </view>
        <view class="ops-tip" wx:if="{{trackReport.launch.total}}">非交易时段打开占比 {{trackReport.launch.nonTradingPct}}%（共 {{trackReport.launch.total}} 次启动）</view>
        <view class="ops-tip" wx:else>窗口期内暂无启动数据</view>

        <!-- 事件计数 -->
        <view class="ops-channel-head" style="margin-top:24rpx">
          <text class="ops-channel-name">📋 事件计数（events 集合）</text>
        </view>
        <view class="ops-channel-tip">记一笔 {{trackReport.events.record_trade}} 条 · 分享确认 {{trackReport.events.share}} 次</view>
        <view class="ops-channel-tip">落地漏斗：分享卡/渠道码到达 {{trackReport.events.share_landing.arrived}} 次（卡片失败 {{trackReport.events.share_landing.cardFail}}）· 横幅转化 {{trackReport.events.share_landing.convert}} 次</view>
        <view class="ops-channel-tip">订阅授权：接受 {{trackReport.events.sub_authorize.accept}} / 拒绝 {{trackReport.events.sub_authorize.reject}} / 失败 {{trackReport.events.sub_authorize.fail}} / 关闭引导 {{trackReport.events.sub_authorize.dismiss}}</view>
        <view class="ops-channel-tip">搜索：{{trackReport.events.search_fund.total}} 次，命中 {{trackReport.events.search_fund.hit}} 次（命中率 {{trackReport.events.search_fund.hitRate == null ? '--' : trackReport.events.search_fund.hitRate + '%'}}）</view>
        <view class="ops-tip" wx:if="{{!trackReport.events.record_trade && !trackReport.events.share && !trackReport.events.search_fund.total && !trackReport.events.sub_authorize.accept}}">窗口期内 events 无数据（新埋点需发版后才开始收集）</view>
      </block>
    </view>

    <!-- ===== 推送灰度看板 ===== -->
    <view wx:if="{{tab === 'push'}}" class="ops-card">
      <view class="ops-card-title">📨 推送灰度看板</view>
      <view class="ops-card-desc">灰度三指标：额度结余为正 / 打开率 ≥15% / 取消订阅率。双条现状维持不增条。</view>
      <view class="ops-add-row">
        <picker mode="selector" range="{{[7, 14, 30, 90]}}" value="{{pushDaysIdx}}" bindchange="onPushDaysChange">
          <button class="ops-mini-btn primary">近 {{pushDays}} 天 ▾</button>
        </picker>
        <button class="ops-add-btn" bind:tap="onGenPushReport" loading="{{pushLoading}}" disabled="{{pushLoading}}">生成看板</button>
      </view>

      <block wx:if="{{pushReport}}">
        <!-- 额度池 -->
        <view class="ops-channel-head" style="margin-top:24rpx">
          <text class="ops-channel-name">💳 额度池（一次授权 = 一条额度）</text>
        </view>
        <view class="ops-stats">
          <view class="ops-stat"><view class="ops-stat-num {{pushReport.quota.quotaSum > 0 ? 'mid' : 'low'}}">{{pushReport.quota.quotaSum}}</view><view class="ops-stat-label">结余总条数</view></view>
          <view class="ops-stat"><view class="ops-stat-num mid">{{pushReport.quota.usersWithQuota}}</view><view class="ops-stat-label">有额度用户</view></view>
          <view class="ops-stat"><view class="ops-stat-num low">{{pushReport.quota.avgPerUser}}</view><view class="ops-stat-label">人均条数</view></view>
        </view>
        <view class="ops-tip">订阅用户共 {{pushReport.quota.usersTotal}} 人 · {{pushReport.quota.quotaSum > 0 ? '结余为正 ✓' : '⚠️ 结余为 0，先补额度引导'}}</view>

        <!-- 打开率 -->
        <view class="ops-channel-head" style="margin-top:24rpx">
          <text class="ops-channel-name">👁 打开率（push_logs 按场景）</text>
        </view>
        <view class="ops-stats">
          <view class="ops-stat"><view class="ops-stat-num {{pushReport.opens.openRate >= 15 ? 'mid' : 'low'}}">{{pushReport.opens.openRate == null ? '--' : pushReport.opens.openRate + '%'}}</view><view class="ops-stat-label">整体打开率</view></view>
          <view class="ops-stat"><view class="ops-stat-num mid">{{pushReport.opens.sent}}</view><view class="ops-stat-label">发送 {{pushReport.opens.sent}} 条</view></view>
          <view class="ops-stat"><view class="ops-stat-num low">{{pushReport.opens.opened}}</view><view class="ops-stat-label">打开 {{pushReport.opens.opened}} 次</view></view>
        </view>
        <view class="ops-channel-tip" wx:for="{{pushReport.opens.scenes}}" wx:key="scene">{{item.scene}}：发 {{item.sent}} · 开 {{item.opened}}（{{item.openRate == null ? '--' : item.openRate + '%'}}）{{item.unsub ? ' · 取消 ' + item.unsub : ''}}</view>

        <!-- 取消订阅 -->
        <view class="ops-channel-head" style="margin-top:24rpx">
          <text class="ops-channel-name">🚫 取消订阅（43101）</text>
        </view>
        <view class="ops-tip">窗口内 {{pushReport.unsub.users}} 人取消（占收到推送用户 {{pushReport.unsub.rate == null ? '--' : pushReport.unsub.rate + '%'}}）{{pushReport.unsub.rate != null && pushReport.unsub.rate > 5 ? ' · ⚠️ 退订率偏高，先减不增' : ''}}</view>
      </block>
    </view>
  </block>
</view>
