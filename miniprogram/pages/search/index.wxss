.search-bar{display:flex;align-items:center;padding:20rpx 24rpx;background:#FFF}
.search-input{flex:1;height:72rpx;padding:0 24rpx;background:#F5F5F5;border-radius:36rpx;font-size:28rpx}
.search-btn{margin-left:16rpx;width:120rpx;height:72rpx;line-height:72rpx;font-size:28rpx;background:var(--primary-gradient);color:#FFF;border-radius:36rpx;text-align:center;padding:0}
.loading,.error,.empty{text-align:center;padding:60rpx 0;font-size:28rpx;color:#999}

/* 骨架屏 */
.skeleton-wrap{padding:24rpx}
.sk-search-item{height:100rpx;border-radius:12rpx;margin-bottom:12rpx}
.error{color:var(--up)}
/* 搜索历史（聚焦且输入为空时展示） */
.history{padding:20rpx 32rpx;background:#FFF;border-bottom:1rpx solid #EEE}
.history-header{display:flex;align-items:center;justify-content:space-between}
.history-title{font-size:26rpx;color:#999}
.history-clear{font-size:24rpx;color:#999;padding:8rpx 0 8rpx 24rpx}
.history-list{display:flex;flex-wrap:wrap;margin-top:16rpx}
.history-item{margin:0 16rpx 16rpx 0;padding:8rpx 24rpx;background:#F5F5F5;border-radius:28rpx;font-size:26rpx;color:#333}
/* 结果项「添加持仓」按钮（source=add 入口时显示） */
.item-add-btn{margin-left:16rpx;width:144rpx;height:56rpx;line-height:56rpx;font-size:24rpx;color:#FFF;background:var(--primary-gradient);border-radius:28rpx;padding:0}
.item-add-btn::after{border:none}
.result-item{display:flex;align-items:center;justify-content:space-between;padding:28rpx 32rpx;background:#FFF;border-bottom:1rpx solid #EEE}
.item-name{font-size:30rpx;color:#333}
.item-code{font-size:24rpx;color:#999;display:block;margin-top:8rpx}
.item-arrow{font-size:28rpx;color:#CCC}
