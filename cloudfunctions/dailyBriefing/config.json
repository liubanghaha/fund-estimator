{
  "runtime": "Nodejs20.19",
  "timeout": 120,
  "permissions": {
    "openapi": ["subscribeMessage.send"]
  },
  "triggers": [
    {
      "name": "confirmBriefTimer",
      "type": "timer",
      "config": "0 0,20,40 20-23 * * 1-5 *"
    },
    {
      "name": "peAlertTimer",
      "type": "timer",
      "config": "0 35 15 * * 1-5 *"
    },
    {
      "name": "weeklyBriefTimer",
      "type": "timer",
      "config": "0 0 10 * * 6 *"
    }
  ]
}
