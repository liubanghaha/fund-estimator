{
  "runtime": "Nodejs20.19",
  "timeout": 120,
  "permissions": {
    "openapi": ["subscribeMessage.send"]
  },
  "triggers": [
    {
      "name": "closingBriefTimer",
      "type": "timer",
      "config": "0 30 15 * * 1-5 *"
    },
    {
      "name": "navBriefTimer",
      "type": "timer",
      "config": "0 30 21 * * 1-5 *"
    },
    {
      "name": "weeklyBriefTimer",
      "type": "timer",
      "config": "0 0 10 * * 6 *"
    }
  ]
}
